  "    drawer(cabecera('GCO-FO-002', 'Evaluación y selección · ' + p.razonSocial, [p.clase, p.catSeleccion ? 'Actual: ' + p.catSeleccion : 'Primera evaluación']), cuerpo,",
  "      '<button class=\"cmp-btn\" onclick=\"CMP.verProv(\\'' + id + '\\')\">← Volver</button><button class=\"cmp-btn pri\" onclick=\"CMP.guardarEval(this)\">Guardar evaluación</button>', '#6d28d9');",
  "    resultadoSel();",
  "  }",
  "  function f2(grupo, k, v, btn) {",
  "    if (grupo.indexOf('g:') === 0) FORM.f2.grupos[grupo.slice(2)].items[k] = v; else FORM.f2[grupo][k] = v;",
  "    Array.prototype.forEach.call(btn.parentNode.children, function (b) { b.classList.toggle('on', b === btn); });",
