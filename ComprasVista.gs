  "    document.getElementById('selCat').innerHTML = todos || excluido || d ? catSel(c) : '';",
  "  }",
  "  function guardarEval(btn) {",
  "    accion(btn, 'cmpGuardarEvaluacionSel', [{ proveedorId: FORM.provEval, motivo: val('evMot'), fecha: val('evFecha'), documentos: FORM.f2.documentos,",
  "      grupos: FORM.f2.grupos, puntajes: FORM.f2.puntajes, controlD: chk('evD'), motivoD: val('evDMot'), observaciones: val('evObs') }], 'evMsg', function (r) {",
  "      toast('Evaluación guardada: categoría ' + r.categoria + ' (' + r.puntaje + ' pts)');",
