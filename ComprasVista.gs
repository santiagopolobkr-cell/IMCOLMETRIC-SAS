  "      var nota = x.url ? (vigente ? 'Cargado en el proveedor' + (x.fecha ? ' · expedido ' + fecha(x.fecha) : '') : 'Cargado pero vencido (' + fecha(x.fecha) + ')') : 'No cargado en el proveedor';",
  "      return '<div class=\"cmp-req\"><span>' + esc(d.t) + '<span class=\"cmp-sub\">' + esc(nota) + (x.url ? ' · ' + enlace(x.url, 'ver') : '') + '</span></span>' + siNo('documentos', d.id, d.na ? ['SI', 'NO', 'N/A'] : ['SI', 'NO'], pre) + '</div>';",
  "    }).join('');",
  "    var grupos = F.grupos.map(function (g) {",
  "      var aplica = (p.categorias || []).indexOf(g.cat) !== -1;",
