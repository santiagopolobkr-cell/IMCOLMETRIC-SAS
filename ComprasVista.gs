  "  function mensaje(id, t) { var e = id && document.getElementById(id); if (e) e.innerText = t || ''; }",
  "",
  "  // ---------- interfaz base ----------",
  "  function asegurarCapas() {",
  "    if (document.getElementById('cmpDrawer')) return;",
