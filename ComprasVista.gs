  "  function imprimirContrato(id) {",
  "    var o = oc(id), c = o.contrato, E = D.config.empresa, p = prov(o.proveedorId) || {};",
  "    if (!c) return;",
  "    var n = function (v) { return esc(v || '________'); };",
  "    var anio = (c.numero || '').slice(-4);",
  "    var pol = function (x, t) { return '<tr><td>' + t + '</td><td>' + (x.aplica ? 'APLICA' : 'NO APLICA') + '</td><td>' + esc(x.aplica ? x.porcentaje : '') + '</td><td>' + esc(x.aplica ? x.plazo : '') + '</td></tr>'; };",
  "    var cl = function (t, txt) { return '<p style=\"text-align:justify;margin:6px 0\"><b>' + t + '</b> ' + txt + '</p>'; };",
  "    var ff = c.fechaFirma ? fecha(c.fechaFirma) : '___ de ______ de ____';",
  "    imprimir('<div style=\"font-size:11.5px;line-height:1.45\">' +",
  "      '<table class=\"enc\"><tr><td style=\"width:24%\"><img src=\"' + LOGO + '\" style=\"max-width:150px;max-height:52px\"></td><td><h1>CONTRATO DE COMPRAVENTA No. ' + esc(c.numero) + '</h1></td><td style=\"width:20%\"><b>GCO-FO-004</b></td></tr></table>' +",
  "      '<table><tr><th style=\"width:28%\">VENDEDOR</th><td>' + esc(o.proveedor) + '</td></tr><tr><th>COMPRADOR</th><td>' + esc(E.nombre) + '</td></tr><tr><th>OBJETO:</th><td>' + n(c.objeto) + '</td></tr>' +",
  "      '<tr><th>VALOR:</th><td>' + pesos(c.valor) + ' (' + esc(enLetras(c.valor)) + ')</td></tr><tr><th>FORMA DE PAGO</th><td>' + n(c.formaPago) + '</td></tr><tr><th>FECHA DE ENTREGA</th><td>' + n(c.fechaEntrega) + '</td></tr>' +",
  "      '<tr><th>LUGAR DE ENTREGA</th><td>' + n(c.lugarEntrega) + '</td></tr><tr><th>VIGENCIA</th><td>' + n(c.vigencia) + '</td></tr><tr><th>DIRECCIÓN DEL VENDEDOR</th><td>' + n(c.direccionVendedor) + '</td></tr>' +",
