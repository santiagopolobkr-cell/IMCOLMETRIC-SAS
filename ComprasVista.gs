  "",
  "  function vEvaluaciones() {",
  "    var pend = D.proveedores.filter(function (p) { return reevaluacionPendiente(p) || p.catDesempeno === 'No confiable'; });",
  "    var lista = D.evaluaciones.filter(function (e) { return !V.fEva || e.tipo === V.fEva; }).sort(function (a, b) { return a.id < b.id ? 1 : -1; });",
  "    var anio = hoy().slice(0, 4);",
  "    var reevaluadosAnio = D.proveedores.filter(function (p) { return requiereSeleccion(p) && p.estado === 'Activo'; });",
  "    var hechos = reevaluadosAnio.filter(function (p) { return p.fechaSeleccion && p.fechaSeleccion.slice(0, 4) === anio; }).length;",
  "    var pan = '<div class=\"cmp-grid cmp-g2\" style=\"margin-bottom:16px\"><div class=\"cmp-card\"><h3>Reevaluación de proveedores <small>al final de cada año · GCO-FO-002</small></h3>' +",
  "      (pend.length ? '<div class=\"cmp-tareas\">' + pend.map(function (p) {",
  "        var nc = p.catDesempeno === 'No confiable', habil = nc && p.fechaDesempeno ? sumarDias(p.fechaDesempeno, 182) : '';",
  "        return '<div class=\"cmp-tarea\"><i style=\"--tc:' + (nc ? '#fee2e2' : '#fef3c7') + '\">' + (nc ? '⛔' : '🔁') + '</i><div><b>' + esc(p.razonSocial) + '</b><span>' +",
  "          (nc ? 'No confiable · nueva evaluación desde ' + fecha(habil) : p.fechaSeleccion ? 'Última evaluación ' + fecha(p.fechaSeleccion) : 'Sin evaluación de selección') + '</span></div>' +",
  "          (D.yo.gestor ? '<button class=\"cmp-btn sm\" onclick=\"CMP.evaluar(\\'' + p.id + '\\')\">Evaluar</button>' : '') + '</div>';",
  "      }).join('') + '</div>' : '<div class=\"cmp-vacio\"><b>✓</b>No hay reevaluaciones pendientes.</div>') + '</div>' +",
  "      '<div class=\"cmp-card\"><h3>Avance ' + anio + '</h3><div class=\"cmp-mini\">Proveedores permanentes evaluados este año</div>' +",
  "      barra([{ t: 'Evaluados', n: hechos, c: '#0f766e' }, { t: 'Pendientes', n: reevaluadosAnio.length - hechos, c: '#f59e0b' }]) +",
  "      '<p class=\"cmp-ayuda\" style=\"margin-top:12px\">También se reevalúa cuando el proveedor notifica cambios en las condiciones de los criterios de evaluación.</p></div></div>';",
  "    var chips = ['', 'Selección', 'Desempeño'].map(function (t) {",
  "      return '<button class=\"cmp-chip' + (V.fEva === t ? ' on' : '') + '\" onclick=\"CMP.filtro(\\'fEva\\',\\'' + t + '\\')\">' + (t || 'Todas') + '</button>';",
  "    }).join('');",
  "    var filas = lista.map(function (e) {",
  "      var r = e.tipo === 'Selección' ? catSel(e.resultado) : badgeEstado(e.resultado);",
  "      return '<tr><td><span class=\"cmp-id\">' + esc(e.id) + '</span><span class=\"cmp-sub\">' + fecha(e.fecha) + '</span></td><td>' + esc(e.tipo) + '<span class=\"cmp-sub\">' + (e.tipo === 'Selección' ? 'GCO-FO-002' : 'GCO-FO-001') + '</span></td>' +",
  "        '<td><button class=\"cmp-lnk\" onclick=\"CMP.verProv(\\'' + e.proveedorId + '\\')\">' + esc(e.proveedor) + '</button></td><td>' + esc(e.motivo) + (e.ref ? '<span class=\"cmp-sub\"><button class=\"cmp-lnk\" onclick=\"CMP.verOC(\\'' + e.ref + '\\')\">' + esc(e.ref) + '</button></span>' : '') + '</td>' +",
  "        '<td><b>' + esc(e.puntaje) + '</b></td><td>' + r + '</td><td>' + esc(e.evaluador) + '</td><td><button class=\"cmp-lnk\" onclick=\"CMP.imprimirEval(\\'' + e.id + '\\')\">Imprimir</button></td></tr>';",
  "    }).join('');",
  "    return pan + '<div class=\"cmp-filtros\">' + chips + '</div><div class=\"cmp-tabla-w\"><table class=\"cmp-tabla\"><thead><tr><th>ID / Fecha</th><th>Tipo</th><th>Proveedor</th><th>Motivo</th><th>Puntaje</th><th>Resultado</th><th>Evaluador</th><th></th></tr></thead><tbody>' +",
  "      (filas || '<tr><td colspan=\"8\"><div class=\"cmp-vacio\">Aún no hay evaluaciones.</div></td></tr>') + '</tbody></table></div>';",
  "  }",
  "",
  "  // ---------- roles ----------",
  "  function vRoles() {",
  "    FORM.roles = JSON.parse(JSON.stringify(D.roles));",
  "    return '<div class=\"cmp-nota\" style=\"margin-bottom:14px\">Cada rol se asigna por <b>cargo</b> (todos los usuarios activos con ese cargo) o por <b>usuario</b>. Cualquier usuario del sistema puede crear solicitudes de compra y recibir y evaluar las suyas.</div>' +",
  "      '<div class=\"cmp-grid\" style=\"grid-template-columns:repeat(auto-fill,minmax(320px,1fr))\" id=\"rlCards\">' + tarjetasRoles() + '</div>' +",
  "      '<div class=\"cmp-msg\" id=\"rlMsg\" style=\"margin-top:10px\"></div><div style=\"text-align:right;margin-top:10px\"><button class=\"cmp-btn pri\" onclick=\"CMP.guardarRoles(this)\">Guardar roles</button></div>';",
  "  }",
  "  function tarjetasRoles() {",
  "    var cargos = {}, usuarios = D.usuarios || [];",
  "    usuarios.forEach(function (u) { if (u.cargo) cargos[u.cargo] = 1; });",
  "    return FORM.roles.map(function (r, i) {",
  "      var miembros = usuarios.filter(function (u) {",
  "        return r.cargos.some(function (c) { return norm(c) === norm(u.cargo); }) || r.usuarios.some(function (x) { return norm(x) === norm(u.usuario); });",
  "      });",
  "      var chip = function (t, tipo, k) { return '<span class=\"cmp-badge cmp-b-teal\">' + esc(t) + ' <button class=\"cmp-lnk bad\" style=\"padding:0 2px\" onclick=\"CMP.rolQuitar(' + i + ',\\'' + tipo + '\\',' + k + ')\">✕</button></span>'; };",
  "      return '<div class=\"cmp-card\"><h3>' + esc(r.t) + '</h3><p class=\"cmp-ayuda\" style=\"margin:-6px 0 12px\">' + esc(r.d) + '</p>' +",
  "        '<div class=\"cmp-mini\" style=\"font-weight:700;margin-bottom:6px\">Cargos</div><div class=\"cmp-prov-tags\" style=\"margin-bottom:6px\">' + (r.cargos.map(function (c, k) { return chip(c, 'cargos', k); }).join('') || '<span class=\"cmp-mini\">Ninguno</span>') + '</div>' +",
  "        '<select onchange=\"CMP.rolAgregar(' + i + ',\\'cargos\\',this.value)\" style=\"width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:7px;font:12.5px Segoe UI,Arial;margin-bottom:12px\">' + opciones(Object.keys(cargos).sort(), '', '+ Agregar cargo…') + '</select>' +",
  "        '<div class=\"cmp-mini\" style=\"font-weight:700;margin-bottom:6px\">Usuarios</div><div class=\"cmp-prov-tags\" style=\"margin-bottom:6px\">' + (r.usuarios.map(function (u, k) {",
  "          var x = usuarios.filter(function (z) { return norm(z.usuario) === norm(u); })[0];",
  "          return chip(x ? x.nombre : u, 'usuarios', k);",
  "        }).join('') || '<span class=\"cmp-mini\">Ninguno</span>') + '</div>' +",
  "        '<select onchange=\"CMP.rolAgregar(' + i + ',\\'usuarios\\',this.value)\" style=\"width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:7px;font:12.5px Segoe UI,Arial\">' +",
  "        opciones(usuarios.map(function (u) { return { v: u.usuario, t: u.nombre + ' · ' + u.cargo }; }), '', '+ Agregar usuario…') + '</select>' +",
  "        '<div class=\"cmp-mini\" style=\"margin-top:12px\">Con este rol hoy: <b>' + (miembros.map(function (u) { return esc(u.nombre); }).join(', ') || 'nadie') + '</b></div></div>';",
  "    }).join('');",
  "  }",
  "  function rolAgregar(i, tipo, v) {",
  "    if (!v) return;",
  "    if (FORM.roles[i][tipo].map(norm).indexOf(norm(v)) === -1) FORM.roles[i][tipo].push(v);",
  "    document.getElementById('rlCards').innerHTML = tarjetasRoles();",
  "  }",
  "  function rolQuitar(i, tipo, k) { FORM.roles[i][tipo].splice(k, 1); document.getElementById('rlCards').innerHTML = tarjetasRoles(); }",
  "  function guardarRoles(btn) {",
  "    accion(btn, 'cmpGuardarRoles', [FORM.roles.map(function (r) { return { id: r.id, cargos: r.cargos, usuarios: r.usuarios }; })], 'rlMsg', function () { toast('Roles guardados'); cargar(); });",
  "  }",
  "",
  "  // ---------- impresión de formatos ----------",
  "  var VERSIONES = { 'GCO-FO-001': 'V1.03.2026', 'GCO-FO-002': 'V1.03.2026', 'GCO-FO-005': 'V0.07.2025', 'GCO-FO-006': 'V0', 'GCO-FO-007': 'V0.04.2026' };",
  "  function encabezadoDoc(titulo, codigo) {",
  "    return '<table class=\"enc\"><tr><td style=\"width:24%\"><img src=\"' + LOGO + '\" style=\"max-width:150px;max-height:52px\"></td><td><h1>' + esc(titulo) + '</h1></td>' +",
  "      '<td style=\"width:20%\"><b>' + esc(codigo) + '</b><br>' + esc(VERSIONES[codigo] || '') + '</td></tr></table>';",
  "  }",
  "  var X = function (c) { return c ? '<b>X</b>' : ''; };",
  "  function imprimir(html) {",
  "    var box = document.getElementById('cmpPrint');",
  "    box.innerHTML = '<div class=\"cmp-doc-imp\">' + html + '</div>';",
  "    document.body.classList.add('cmp-imprime');",
  "    var fin = function () { document.body.classList.remove('cmp-imprime'); window.removeEventListener('afterprint', fin); };",
  "    window.addEventListener('afterprint', fin);",
  "    setTimeout(function () { try { window.print(); } catch (e) { toast('No se pudo abrir la impresión', true); } setTimeout(fin, 1500); }, 150);",
  "  }",
  "  function imprimirSol(id) {",
  "    var s = sol(id), c = cat(s.categoria), r = s.requisitos || {};",
  "    imprimir(encabezadoDoc('SOLICITUD DE COMPRA Y/O SERVICIO', 'GCO-FO-006') +",
  "      '<table><tr><th>N° Solicitud</th><td>' + esc(s.id) + '</td><th>Fecha</th><td>' + esc(s.fecha) + '</td></tr>' +",
  "      '<tr><th>Solicitante</th><td>' + esc(s.nombre) + '</td><th>Cargo</th><td>' + esc(s.cargo) + '</td></tr>' +",
  "      '<tr><th>Área / proceso</th><td>' + esc(s.area) + '</td><th>Tipo</th><td>' + esc(s.tipo) + '</td></tr>' +",
  "      '<tr><th>Categoría</th><td>' + esc(c.t) + (c.critica ? ' (crítica)' : '') + '</td><th>Fecha requerida</th><td>' + esc(s.fechaRequerida) + '</td></tr>' +",
  "      '<tr><th>Valor estimado</th><td>' + pesos(s.valorEstimado) + '</td><th>Proveedor sugerido</th><td>' + esc(s.proveedorSugerido) + '</td></tr>' +",
  "      '<tr><th>Necesidad</th><td colspan=\"3\">' + esc(s.justificacion) + '</td></tr></table>' +",
  "      '<table><tr><th>#</th><th>Descripción</th><th>Especificación</th><th>Cantidad</th><th>Unidad</th></tr>' + (s.items || []).map(function (i, k) {",
  "        return '<tr><td>' + (k + 1) + '</td><td>' + esc(i.descripcion) + '</td><td>' + esc(i.especificaciones) + '</td><td>' + esc(i.cantidad) + '</td><td>' + esc(i.unidad) + '</td></tr>';",
  "      }).join('') + '</table>' +",
  "      '<table><tr><th colspan=\"2\">REQUISITOS A COMUNICAR AL PROVEEDOR</th></tr><tr><th>Técnicos</th><td>' + esc(r.tecnicos) + '</td></tr><tr><th>Competencia / acreditación</th><td>' + esc(r.competencia) + '</td></tr>' +",
  "      '<tr><th>Criterios de aceptación</th><td>' + esc(r.aceptacion) + '</td></tr><tr><th>Documentación requerida</th><td>' + esc((r.documentos || []).join(', ')) + '</td></tr><tr><th>Condiciones de entrega</th><td>' + esc(r.entrega) + '</td></tr></table>' +",
  "      '<table class=\"firmas\"><tr><td>' + esc(s.nombre) + '<br><b>Solicitante</b></td><td>' + esc(s.aprobTec ? s.aprobTec.por + ' (' + s.aprobTec.estado + ')' : '') + '<br><b>Aprobación técnica</b></td><td><br><b>Compras</b></td></tr></table>');",
  "  }",
  "  function imprimirOC(id) {",
  "    var o = oc(id), s = sol(o.solicitud) || {}, r = s.requisitos || {};",
  "    var req = [r.tecnicos ? 'Requisitos técnicos: ' + r.tecnicos : '', r.competencia ? 'Competencia/acreditación: ' + r.competencia : '', r.aceptacion ? 'Criterios de aceptación: ' + r.aceptacion : '',",
  "      (r.documentos || []).length ? 'Documentación a entregar: ' + r.documentos.join(', ') : '', r.entrega ? 'Entrega: ' + r.entrega : '',",
  "      'Entrega pactada: ' + o.fechaEntrega + ' en ' + (o.lugarEntrega || 'sede IMCOLMETRIC')].filter(Boolean);",
  "    var items = (o.items || []).map(function (i, k) {",
  "      var b = i.cantidad * i.valorUnitario;",
  "      return '<tr><td>' + (k + 1) + '</td><td>' + esc(i.cantidad) + '</td><td>' + esc(i.descripcion) + '</td><td>' + esc(i.lote || 'N/A') + '</td><td class=\"der\">' + pesos(i.valorUnitario) +",
  "        '</td><td class=\"der\">' + esc(i.ivaPct) + '%</td><td class=\"der\">' + pesos(b * i.ivaPct / 100) + '</td><td class=\"der\">' + pesos(b) + '</td></tr>';",
  "    });",
  "    while (items.length < 4) items.push('<tr><td>' + (items.length + 1) + '</td><td></td><td></td><td>N/A</td><td></td><td class=\"der\">0%</td><td></td><td></td></tr>');",
  "    imprimir(encabezadoDoc('ORDEN DE COMPRA', 'GCO-FO-005') +",
  "      '<table><tr><td style=\"width:50%;border:none\"></td><th style=\"text-align:center\">ORDEN DE COMPRA No.</th></tr><tr><td style=\"border:none\"></td><td style=\"text-align:center;font-size:14px\"><b>' + esc(o.id) + '</b> · ' + esc(o.fecha) + '</td></tr></table>' +",
  "      '<table><tr><th style=\"width:14%\">Cliente:</th><td>' + esc(o.proveedor) + '</td><th style=\"width:14%\">RESPONSABLE</th><td>' + esc(o.responsable || o.elaboro) + '</td><th style=\"width:14%\">FORMA DE PAGO:</th><td>' + esc(o.formaPago) + '</td></tr>' +",
  "      '<tr><th>NIT:</th><td>' + esc(o.nit) + '</td><th rowspan=\"3\">CONCEPTO</th><td rowspan=\"3\" colspan=\"3\">' + esc(o.concepto) + '</td></tr>' +",
  "      '<tr><th>Dirección</th><td>' + esc(o.direccion) + '</td></tr><tr><th>Ciudad</th><td>' + esc(o.ciudad) + '</td></tr></table>' +",
  "      '<table><tr><th>Item</th><th>Cantidad</th><th style=\"width:38%\">Descripción</th><th>Lote</th><th class=\"der\">V. Unitario</th><th class=\"der\">IVA</th><th class=\"der\">Valor IVA</th><th class=\"der\">Subtotal</th></tr>' + items.join('') + '</table>' +",
  "      '<table><tr><td rowspan=\"4\" style=\"width:55%\"><b>Observaciones:</b><br>' + esc(o.observaciones) + (o.observaciones ? '<br>' : '') + esc(req.join(' · ')) + '</td><th>SUBTOTAL</th><td class=\"der\">' + pesos(o.subtotal) + '</td></tr>' +",
  "      '<tr><th>DESCUENTO</th><td class=\"der\">' + pesos(o.descuento) + '</td></tr><tr><th>TOTAL IVA</th><td class=\"der\">' + pesos(o.iva) + '</td></tr><tr><th>TOTAL FACTURA</th><td class=\"der\"><b>' + pesos(o.total) + '</b></td></tr></table>' +",
  "      '<p style=\"margin:10px 0\"><b>Valor en letras:</b><br>' + esc(o.valorLetras || enLetras(o.total)) + '</p>' +",
  "      '<p style=\"margin:26px 0 18px\">Firma responsable: ______________________ &nbsp; ' + esc(o.responsable || o.elaboro) + '</p><p>Recibido por:______________________</p>');",
  "  }",
  "  function imprimirEval(id) {",
  "    var e = D.evaluaciones.filter(function (x) { return x.id === id; })[0];",
  "    if (!e) return;",
  "    if (e.tipo === 'Selección') imprimirFO002(e); else imprimirFO001(e);",
  "  }",
  "  function imprimirFO002(e) {",
  "    var F = D.config.fo002, d = e.detalle || {}, p = prov(e.proveedorId) || {};",
  "    var filasDoc = F.documentos.map(function (x) {",
  "      var v = (d.documentos || {})[x.id];",
  "      return '<tr><td>' + esc(x.t) + '</td><td style=\"text-align:center\">' + (v === 'N/A' ? 'N/A' : X(v === 'SI')) + '</td><td style=\"text-align:center\">' + X(v === 'NO') + '</td></tr>';",
  "    }).join('');",
  "    var filasG = F.grupos.map(function (g) {",
  "      var x = (d.grupos || {})[g.id] || {};",
  "      return '<tr><th>' + esc(g.t) + '</th><th style=\"text-align:center\">' + (x.aplica ? 'SI' : 'N/A') + '</th><th style=\"text-align:center\">' + (x.aplica ? 'NO' : 'N/A') + '</th></tr>' + g.items.map(function (t, k) {",
  "        var v = x.aplica ? (x.items || {})[k] : '';",
  "        return '<tr><td>' + esc(t) + '</td><td style=\"text-align:center\">' + X(v === 'SI') + '</td><td style=\"text-align:center\">' + X(v === 'NO') + '</td></tr>';",
  "      }).join('');",
  "    }).join('');",
  "    var secc = F.puntajes.map(function (c) {",
  "      var k = (d.puntajes || {})[c.id];",
  "      return '<table><tr><th>' + esc(c.t) + '</th><th style=\"width:16%;text-align:center\">MARQUE X SI APLICA</th><th style=\"width:12%;text-align:center\">PUNTAJE</th></tr>' + c.ops.map(function (op, i) {",
  "        return '<tr><td>' + esc(op[0]) + '</td><td style=\"text-align:center\">' + X(k === i) + '</td><td style=\"text-align:center\">' + (k === i ? op[1] : '') + '</td></tr>';",
  "      }).join('') + '</table>';",
  "    }).join('');",
  "    imprimir(encabezadoDoc('EVALUACIÓN Y SELECCIÓN DE PROVEEDORES', 'GCO-FO-002') +",
  "      '<table><tr><th colspan=\"4\">DATOS DE QUIEN EVALUA AL PROVEEDOR</th></tr><tr><th>DILIGENCIADO POR:</th><td colspan=\"3\">' + esc(e.evaluador) + '</td></tr>' +",
  "      '<tr><th>FECHA DE DILIGENCIAMIENTO:</th><td>' + esc(e.fecha) + '</td><th>CARGO:</th><td>' + esc(d.cargo) + '</td></tr>' +",
  "      '<tr><th colspan=\"4\">DATOS PROVEEDOR:</th></tr><tr><th>NOMBRE, RAZON SOCIAL O PÁGINA WEB DEL PROVEEDOR:</th><td>' + esc(e.proveedor) + '</td><th>NIT/CC:</th><td>' + esc(p.nit) + '</td></tr></table>' +",
  "      '<table><tr><th>1. DOCUMENTOS LEGALES U OBLIGATORIOS</th><th style=\"width:8%;text-align:center\">SI</th><th style=\"width:8%;text-align:center\">NO</th></tr>' + filasDoc + filasG + '</table>' +",
  "      '<p style=\"font-size:10px;margin:4px 0 8px\">POR FAVOR, MARQUE CON UNA \"X\" ÚNICAMENTE DONDE SE LE INDIQUE Y DE ACUERDO A LA DOCUMENTACIÓN SUMINISTRADA</p>' + secc +",
  "      '<table><tr><th>RESULTADOS DEL PROVEEDOR</th><th style=\"width:16%;text-align:center\">CATEGORÍA</th><th style=\"width:16%;text-align:center\">PUNTAJE TOTAL</th></tr>' +",
  "      '<tr><td>CATEGORIA DEL PROVEEDOR' + (e.resultado === 'Excluido' ? ' · No cumple los requisitos exigidos' : '') + (d.controlD ? ' · Control interno: ' + esc(d.motivoD) : '') + '</td><td style=\"text-align:center;font-size:15px\"><b>' + esc(e.resultado === 'Excluido' ? 'NO SELECCIONABLE' : e.resultado) + '</b></td><td style=\"text-align:center;font-size:15px\"><b>' + esc(e.puntaje) + '</b></td></tr></table>' +",
  "      (e.observaciones ? '<p><b>Observaciones:</b> ' + esc(e.observaciones) + '</p>' : ''));",
  "  }",
  "  function imprimirFO001(e) {",
  "    if (typeof e === 'string') e = D.evaluaciones.filter(function (x) { return x.id === e; })[0];",
  "    if (!e) return;",
  "    var F = D.config.fo001, d = e.detalle || {}, cal = d.calificaciones || {}, an = d.anotaciones || {}, p = prov(e.proveedorId) || {};",
  "    var filas = F.caracteristicas.concat(F.generales).map(function (c) {",
  "      return c.ops.map(function (op, i) {",
  "        return '<tr>' + (i === 0 ? '<th rowspan=\"' + c.ops.length + '\" style=\"width:16%\">' + esc(c.t) + '</th>' : '') + '<td style=\"text-align:center;width:6%\">' + op[0] + '</td><td style=\"font-size:9.5px\">' + esc(op[1]) + '</td>' +",
  "          (i === 0 ? '<td rowspan=\"' + c.ops.length + '\" style=\"width:18%\">' + esc(an[c.id] || '') + '</td><td rowspan=\"' + c.ops.length + '\" style=\"width:8%;text-align:center;font-size:13px\"><b>' + esc(cal[c.id] === undefined ? '' : cal[c.id]) + '</b></td>' : '') + '</tr>';",
  "      }).join('');",
  "    }).join('');",
  "    imprimir(encabezadoDoc('EVALUACIÓN DE SEGUIMIENTO DE PROVEEDORES', 'GCO-FO-001') +",
  "      '<table><tr><th>NOMBRE O RAZÓN SOCIAL DE PROVEEDOR:</th><td colspan=\"3\">' + esc(e.proveedor) + '</td><th rowspan=\"3\" style=\"text-align:center\">RESULTADO DE LA EVALUACIÓN<br><span style=\"font-size:18px\">' + esc(e.puntaje) + '</span><br>' + esc(e.resultado) + '</th></tr>' +",
  "      '<tr><th>C.C. O NIT:</th><td>' + esc(p.nit) + '</td><th>FECHA:</th><td>' + esc(e.fecha) + '</td></tr><tr><th>PRODUCTO O SERVICIO A CALIFICAR:</th><td colspan=\"3\">' + esc(d.productoServicio) + (e.ref ? ' · ' + esc(e.ref) : '') + '</td></tr></table>' +",
  "      '<p style=\"font-size:10px;margin:4px 0 8px\">Verificado el cumplimiento o no de los factores de evaluación establecidos en la siguiente tabla, se calificará al Proveedor conforme a los siguientes criterios:</p>' +",
  "      '<table><tr><th>CARACTERÍSTICAS</th><th>PUNTAJE</th><th>CRITERIOS</th><th>ANOTACIONES U OBSERVACIONES</th><th>CALIFICACIÓN</th></tr>' + filas +",
  "      '<tr><td colspan=\"4\" class=\"der\"><b>PROMEDIO</b></td><td style=\"text-align:center\"><b>' + esc(e.puntaje) + '</b></td></tr></table>' +",
  "      '<p style=\"font-size:10px\">*Diligenciar el formato para el servicio o producto que aplique. Si hay un servicio o producto que no aplica, el campo queda en N/A.</p>' +",
  "      '<table style=\"width:60%\"><tr><th>CATEGORÍA DE DESEMPEÑO</th><th>CRITERIO</th><th>DECISIÓN</th></tr><tr><td>Altamente Confiable</td><td>Puntaje ≥ 85</td><td>Continuar</td></tr>' +",
  "      '<tr><td>Confiable</td><td>70 ≤ Puntaje ≤ 84</td><td>Continuar</td></tr><tr><td>No Confiable</td><td>Puntaje &lt; 70</td><td>No Continuar</td></tr></table>' +",
  "      '<p><b>OBSERVACIONES:</b> ' + esc(e.observaciones) + '</p><p style=\"margin-top:24px\"><b>RESPONSABLE (NOMBRE LEGIBLE):</b> ' + esc(d.responsable || e.evaluador) + '<br><span style=\"font-size:10px\">PERSONA QUIÉN DILIGENCIA ESTE FORMATO</span></p>');",
  "  }",
  "  function imprimirMatriz() {",
  "    var lista = D.proveedores.filter(function (p) { return p.estado !== 'Eliminado'; }).sort(function (a, b) { return a.razonSocial.localeCompare(b.razonSocial, 'es'); });",
  "    imprimir(encabezadoDoc('MATRIZ DE PROVEEDORES', 'GCO-FO-007') +",
  "      '<table><tr><th>Nº</th><th>Proveedor</th><th>NIT</th><th>Producto/Servicio</th><th>Estado</th><th>Fecha última evaluación</th><th>Próxima reevaluación</th><th>Responsable evaluación</th><th>Observaciones</th></tr>' +",
  "      lista.map(function (p, k) {",
