  "  // ---------- orden de compra ----------",
  "  function formOC(solId) {",
  "    var s = sol(solId);",
  "    var cots = D.cotizaciones.filter(function (x) { return x.solicitud === solId; });",
  "    var menor = cots.reduce(function (m, x) { return !m || x.valor < m.valor ? x : m; }, null);",
  "    FORM.oc = { sol: solId, cot: menor ? menor.id : '', prov: menor ? menor.proveedorId : '' };",
  "    var c0 = menor || {};",
  "    FORM.ocItems = (s.items || []).map(function (i) {",
  "      var vu = (s.items.length === 1 && c0.valor && Number(i.cantidad)) ? Math.round(c0.valor / Number(i.cantidad)) : 0;",
  "      return { descripcion: i.descripcion + (i.especificaciones ? ' · ' + i.especificaciones : ''), cantidad: i.cantidad, lote: 'N/A', valorUnitario: vu, ivaPct: 0 };",
  "    });",
  "    var cuerpo = '<div class=\"cmp-sec\"><h4>1 · Cotización con la que se emite la orden</h4><div class=\"cmp-cots\" id=\"ocCots\">' + cotsElegibles(cots) + '</div></div>' +",
  "      '<div class=\"cmp-sec\"><h4>2 · Ítems y valores <button type=\"button\" class=\"cmp-btn sm\" onclick=\"CMP.ocItemMas()\">+ Ítem</button></h4><div class=\"cmp-items\" id=\"ocItems\"></div>' +",
  "      '<div class=\"cmp-tot\" style=\"align-items:center\"><span>Descuento <input type=\"number\" min=\"0\" id=\"ocDesc\" value=\"0\" oninput=\"CMP.ocTotales()\" style=\"width:130px;border:1px solid #cbd5e1;border-radius:8px;padding:6px 8px;font:13px Segoe UI,Arial;margin-left:6px\"></span></div>' +",
  "      '<div class=\"cmp-tot\" id=\"ocTot\"></div><div class=\"cmp-ayuda\" id=\"ocLetras\" style=\"text-align:right;margin-top:4px\"></div><div id=\"ocCotAviso\"></div></div>' +",
  "      '<div class=\"cmp-sec\"><h4>3 · Datos de la orden</h4><div class=\"cmp-form\">' +",
  "      campo('Responsable', '<input id=\"ocResp\" value=\"' + esc(D.yo.nombre) + '\">', true) +",
  "      campo('Concepto', '<input id=\"ocConc\" value=\"' + esc(cat(s.categoria).t + ' · ' + s.area) + '\">', true) +",
  "      campo('Forma de pago', '<input id=\"ocPago\" list=\"ctPagos2\" value=\"' + esc(c0.formaPago || '') + '\"><datalist id=\"ctPagos2\"><option value=\"Contado\"><option value=\"Crédito 30 días\"><option value=\"Crédito 60 días\"><option value=\"Anticipo 50 %\"><option value=\"Contra entrega\"></datalist>', true) +",
  "      campo('Fecha de entrega pactada', '<input type=\"date\" id=\"ocFecha\" value=\"' + esc(sumarDias(hoy(), Number(c0.diasEntrega) || 7)) + '\" onchange=\"CMP.ocSeg()\">', true, false, '<span id=\"ocSegAviso\"></span>') +",
  "      campo('Lugar de entrega', '<input id=\"ocLugar\" value=\"' + esc(s.lugarEntrega || '') + '\">') +",
  "      campo('Excepción de tres cotizaciones', '<textarea id=\"ocExc\" placeholder=\"Solo si la compra supera el monto y no hay tres cotizaciones: justifica la capacidad técnica del proveedor (Nota 2, laboratorio)\" oninput=\"CMP.ocRevisar()\"></textarea>', false, true) +",
  "      campo('Observaciones', '<textarea id=\"ocObs\"></textarea>', false, true) +",
  "      '</div></div>' +",
  "      '<div class=\"cmp-sec\"><h4>4 · Controles del procedimiento <span class=\"cmp-mini\" id=\"ocCtlRes\"></span></h4><div id=\"ocCtl\"><div class=\"cmp-ayuda\">Revisando…</div></div><div id=\"ocAut\"></div></div>' +",
  "      '<div class=\"cmp-msg\" id=\"ocMsg\"></div>';",
  "    cuerpo = cuerpo.replace('<div class=\"cmp-msg\" id=\"ocMsg\"></div>', '<p class=\"cmp-ayuda\">Si la compra requiere contrato de compraventa (GCO-FO-004), lo elaboras desde la orden una vez emitida.</p><div class=\"cmp-msg\" id=\"ocMsg\"></div>');",
  "    drawer(cabecera('GCO-FO-005', 'Orden de compra · ' + s.id, [cat(s.categoria).t, s.nombre]), cuerpo,",
  "      '<button class=\"cmp-btn\" onclick=\"CMP.verSol(\\'' + solId + '\\')\">← Volver</button><button class=\"cmp-btn pri\" id=\"ocEmitir\" onclick=\"CMP.crearOC(this)\">Emitir orden de compra</button>', '#1e3a8a');",
  "    pintarItemsOC();",
  "    ocSeg();",
  "  }",
  "  function cotsElegibles(cots) {",
  "    return cots.map(function (x) {",
  "      var p = prov(x.proveedorId) || {};",
  "      return '<div class=\"cmp-cot elegible' + (FORM.oc.cot === x.id ? ' sel' : '') + '\" onclick=\"CMP.ocCot(\\'' + x.id + '\\')\"><b>' + esc(x.proveedor) + '</b><span class=\"v\">' + pesos(x.valor) + '</span>' +",
  "        '<span class=\"cmp-mini\">' + esc(x.diasEntrega || 0) + ' días · ' + esc(x.formaPago || '—') + '</span><span class=\"cmp-mini\">Selección: ' + esc(p.catSeleccion || 'sin evaluar') + (p.catDesempeno ? ' · ' + esc(p.catDesempeno) : '') + '</span></div>';",
  "    }).join('');",
  "  }",
  "  function ocCot(id) {",
  "    var c = D.cotizaciones.filter(function (x) { return x.id === id; })[0];",
  "    FORM.oc.cot = id; FORM.oc.prov = c.proveedorId;",
  "    leerItemsOC();",
  "    if (FORM.ocItems.length === 1 && Number(FORM.ocItems[0].cantidad)) { FORM.ocItems[0].valorUnitario = Math.round(c.valor / Number(FORM.ocItems[0].cantidad)); FORM.ocItems[0].ivaPct = 0; }",
  "    document.getElementById('ocCots').innerHTML = cotsElegibles(D.cotizaciones.filter(function (x) { return x.solicitud === FORM.oc.sol; }));",
  "    if (c.formaPago) document.getElementById('ocPago').value = c.formaPago;",
  "    if (c.diasEntrega) document.getElementById('ocFecha').value = sumarDias(hoy(), Number(c.diasEntrega));",
  "    pintarItemsOC(); ocSeg();",
  "  }",
  "  function leerItemsOC() {",
  "    var filas = document.querySelectorAll('#ocItems .cmp-it[data-i]');",
  "    FORM.ocItems = Array.prototype.map.call(filas, function (f) {",
  "      var q = function (c) { var e = f.querySelector('.' + c); return e ? e.value : ''; };",
  "      return { descripcion: q('oD'), cantidad: q('oC'), lote: q('oL'), valorUnitario: q('oV'), ivaPct: q('oI') };",
  "    });",
  "  }",
  "  function pintarItemsOC() {",
  "    document.getElementById('ocItems').innerHTML = '<div class=\"cmp-it oc cmp-it-h\"><span>Descripción</span><span>Cantidad</span><span>Lote</span><span>V. Unitario</span><span>IVA %</span><span>Valor IVA / Subtotal</span><span></span></div>' +",
  "      FORM.ocItems.map(function (i, k) {",
  "        return '<div class=\"cmp-it oc\" data-i=\"' + k + '\"><textarea class=\"oD\">' + esc(i.descripcion) + '</textarea>' +",
  "          '<input class=\"oC\" type=\"number\" min=\"0\" step=\"any\" value=\"' + esc(i.cantidad) + '\" oninput=\"CMP.ocTotales()\"><input class=\"oL\" value=\"' + esc(i.lote || 'N/A') + '\">' +",
  "          '<input class=\"oV\" type=\"number\" min=\"0\" value=\"' + esc(i.valorUnitario) + '\" oninput=\"CMP.ocTotales()\">' +",
  "          '<select class=\"oI\" onchange=\"CMP.ocTotales()\">' + opciones([{ v: 0, t: '0' }, { v: 5, t: '5' }, { v: 19, t: '19' }], i.ivaPct) + '</select>' +",
  "          '<span class=\"oS\" style=\"padding-top:4px;font-size:12px;line-height:1.35\"></span><button type=\"button\" class=\"cmp-x\" onclick=\"CMP.ocItemMenos(' + k + ')\">✕</button></div>';",
  "      }).join('');",
  "    ocTotales();",
  "  }",
  "  function ocItemMas() { leerItemsOC(); FORM.ocItems.push({ descripcion: '', cantidad: 1, lote: 'N/A', valorUnitario: 0, ivaPct: 0 }); pintarItemsOC(); }",
  "  function ocItemMenos(k) { leerItemsOC(); FORM.ocItems.splice(k, 1); pintarItemsOC(); }",
  "  function totalesOC() {",
  "    leerItemsOC();",
  "    var sub = 0, iva = 0, desc = Math.max(0, Number(val('ocDesc')) || 0);",
  "    FORM.ocItems.forEach(function (i) { var b = (Number(i.cantidad) || 0) * (Number(i.valorUnitario) || 0); sub += b; iva += b * (Number(i.ivaPct) || 0) / 100; });",
  "    return { sub: sub, desc: desc, iva: iva, total: Math.round(sub - desc + iva) };",
  "  }",
  "  var revT = null;",
  "  function ocTotales() {",
  "    var t = totalesOC();",
  "    var filas = document.querySelectorAll('#ocItems .cmp-it[data-i]');",
  "    Array.prototype.forEach.call(filas, function (f, k) {",
  "      var i = FORM.ocItems[k];",
  "      var b = (Number(i.cantidad) || 0) * (Number(i.valorUnitario) || 0);",
  "      f.querySelector('.oS').innerHTML = 'IVA ' + pesos(b * (Number(i.ivaPct) || 0) / 100) + '<br><b>' + pesos(b) + '</b>';",
  "    });",
  "    document.getElementById('ocTot').innerHTML = '<span>Subtotal ' + pesos(t.sub) + '</span><span>Descuento ' + pesos(t.desc) + '</span><span>Total IVA ' + pesos(t.iva) + '</span><span>Total factura <b>' + pesos(t.total) + '</b></span>';",
  "    document.getElementById('ocLetras').innerText = t.total > 0 ? 'Valor en letras: ' + enLetras(t.total) : '';",
  "    var c = D.cotizaciones.filter(function (x) { return x.id === FORM.oc.cot; })[0], av = document.getElementById('ocCotAviso');",
  "    if (av) av.innerHTML = !t.total ? '<div class=\"cmp-nota warn\" style=\"margin-top:8px\">Ingresa el valor unitario de cada ítem según la cotización' + (c ? ' (' + pesos(c.valor) + ')' : '') + '.</div>' :",
  "      c && Math.abs(t.total - c.valor) > 1 ? '<div class=\"cmp-nota warn\" style=\"margin-top:8px\">El total de la orden (' + pesos(t.total) + ') es distinto al de la cotización (' + pesos(c.valor) + '). La compra se realiza bajo las condiciones pactadas en la cotización.</div>' : '';",
  "    ocRevisar();",
  "  }",
  "  function ocSeg() {",
  "    var f = val('ocFecha'), e = document.getElementById('ocSegAviso');",
  "    if (!e) return;",
  "    var d = f ? dias(hoy(), f) : 0;",
  "    e.innerHTML = d > 60 ? 'Entrega en ' + d + ' días: seguimiento <b>quincenal</b> los primeros 60 días y luego semanal.' :",
  "      d > 7 ? 'Entrega en ' + d + ' días: requiere seguimiento <b>semanal</b>.' : 'Entrega en ' + Math.max(d, 0) + ' días: no requiere seguimiento.';",
  "  }",
  "  function ocRevisar() {",
  "    clearTimeout(revT);",
  "    revT = setTimeout(function () {",
  "      if (!FORM.oc || !document.getElementById('ocCtl')) return;",
  "      if (!FORM.oc.prov) { document.getElementById('ocCtl').innerHTML = '<div class=\"cmp-ayuda\">Selecciona la cotización.</div>'; return; }",
  "      srv('cmpRevisarOrden', [usuario(), FORM.oc.sol, FORM.oc.prov, totalesOC().total, FORM.oc.cot, val('ocExc')], pintarControles,",
  "        function (e) { document.getElementById('ocCtl').innerHTML = '<div class=\"cmp-nota bad\">' + esc(e) + '</div>'; });",
  "    }, 350);",
  "  }",
  "  function pintarControles(ctl) {",
  "    var box = document.getElementById('ocCtl');",
  "    if (!box) return;",
  "    var duros = ctl.filter(function (c) { return !c.ok && !c.autorizable; }), docs = ctl.filter(function (c) { return !c.ok && c.autorizable; });",
  "    box.innerHTML = ctl.map(function (c) {",
  "      return '<div class=\"cmp-ctl' + (c.ok ? '' : c.autorizable ? ' aut' : ' no') + '\"><i>' + (c.ok ? '✓' : c.autorizable ? '!' : '✕') + '</i><div>' + esc(c.t) + (c.detalle ? '<span>' + esc(c.detalle) + '</span>' : '') + '</div></div>';",
  "    }).join('');",
  "    document.getElementById('ocCtlRes').innerHTML = duros.length ? '<span class=\"cmp-badge cmp-b-rojo\">' + duros.length + ' bloqueo(s)</span>' :",
  "      docs.length ? '<span class=\"cmp-badge cmp-b-amar\">Requiere autorización de Gerencia</span>' : '<span class=\"cmp-badge cmp-b-verde\">Todo en regla</span>';",
  "    var aut = document.getElementById('ocAut'), b = document.getElementById('ocEmitir');",
  "    if (!duros.length && docs.length && D.yo.roles.gerencia) {",
  "      if (!document.getElementById('ocMotAut')) aut.innerHTML = '<div class=\"cmp-nota warn\" style=\"margin-top:10px\">Como Gerencia puedes autorizar la orden aunque falten documentos del proveedor.</div>' +",
  "        campo('Motivo de la autorización de Gerencia', '<textarea id=\"ocMotAut\"></textarea>', true, true);",
  "    } else aut.innerHTML = !duros.length && docs.length ? '<div class=\"cmp-nota warn\" style=\"margin-top:10px\">Faltan documentos del proveedor: actualízalos en el proveedor o pide a Gerencia que emita la orden.</div>' : '';",
  "    if (b) b.disabled = !!duros.length || (docs.length > 0 && !D.yo.roles.gerencia);",
  "  }",
  "  function crearOC(btn) {",
  "    leerItemsOC();",
  "    var d = { solicitud: FORM.oc.sol, proveedorId: FORM.oc.prov, cotizacion: FORM.oc.cot, items: FORM.ocItems, formaPago: val('ocPago'), fechaEntrega: val('ocFecha'),",
  "      lugarEntrega: val('ocLugar'), excepcion: val('ocExc'), observaciones: val('ocObs'), motivoAutorizacion: val('ocMotAut'),",
  "      descuento: val('ocDesc'), responsable: val('ocResp'), concepto: val('ocConc') };",
  "    accion(btn, 'cmpCrearOrden', [d], 'ocMsg', function (r) { toast('Orden ' + r.id + ' emitida'); cargar(function () { verOC(r.id); }); });",
  "  }",
  "",
  "  function vOrdenes() {",
  "    var lista = D.ordenes.filter(function (o) {",
  "      if (V.fOC === 'camino' && EN_CAMINO.indexOf(o.estado) === -1) return false;",
  "      if (V.fOC && V.fOC !== 'camino' && o.estado !== V.fOC) return false;",
  "      if (V.bOC && norm([o.id, o.proveedor, o.nit, o.solicitud].join(' ')).indexOf(norm(V.bOC)) === -1) return false;",
  "      return true;",
  "    }).sort(function (a, b) { return a.id < b.id ? 1 : -1; });",
  "    var fil = [{ v: '', t: 'Todas' }, { v: 'Emitida', t: 'Por enviar' }, { v: 'camino', t: 'En camino' }, { v: 'Recibida', t: 'Por evaluar' }, { v: 'Evaluada', t: 'Por facturar' }, { v: 'Cerrada', t: 'Cerradas' }, { v: 'Anulada', t: 'Anuladas' }];",
  "    var chips = fil.map(function (f) {",
  "      var n = D.ordenes.filter(function (o) { return !f.v || (f.v === 'camino' ? EN_CAMINO.indexOf(o.estado) !== -1 : o.estado === f.v); }).length;",
  "      return '<button class=\"cmp-chip' + (V.fOC === f.v ? ' on' : '') + '\" onclick=\"CMP.filtro(\\'fOC\\',\\'' + f.v + '\\')\">' + esc(f.t) + ' · ' + n + '</button>';",
  "    }).join('');",
  "    var filas = lista.map(function (o) {",
  "      var px = proximoSeguimiento(o), abierta = ['Cerrada', 'Anulada'].indexOf(o.estado) === -1 && !o.recepcion;",
  "      var d = dias(hoy(), o.fechaEntrega);",
  "      return '<tr><td><span class=\"cmp-id\">' + esc(o.id) + '</span><span class=\"cmp-sub\">' + fecha(o.fecha) + '</span></td>' +",
  "        '<td>' + esc(o.proveedor) + '<span class=\"cmp-sub\">NIT ' + esc(o.nit) + '</span></td>' +",
  "        '<td><button class=\"cmp-lnk\" onclick=\"CMP.verSol(\\'' + o.solicitud + '\\')\">' + esc(o.solicitud) + '</button></td>' +",
  "        '<td><b>' + pesos(o.total) + '</b></td>' +",
  "        '<td>' + fecha(o.fechaEntrega) + (abierta ? '<span class=\"cmp-sub\" style=\"color:' + (d < 0 ? '#dc2626' : '#64748b') + '\">' + (d < 0 ? 'Atrasada ' + (-d) + ' días' : d === 0 ? 'Hoy' : 'En ' + d + ' días') + '</span>' : '') +",
  "        (px ? '<span class=\"cmp-sub\" style=\"color:' + (px < hoy() ? '#dc2626' : '#0f766e') + '\">Seguimiento ' + fecha(px) + '</span>' : '') + '</td>' +",
  "        '<td>' + badgeEstado(o.estado) + '</td>' +",
  "        '<td><div class=\"cmp-acc\"><button class=\"cmp-lnk\" onclick=\"CMP.verOC(\\'' + o.id + '\\')\">Ver</button><button class=\"cmp-lnk\" onclick=\"CMP.imprimirOC(\\'' + o.id + '\\')\">Imprimir</button>' +",
  "        (D.yo.gestor && ['Cerrada', 'Anulada'].indexOf(o.estado) === -1 ? '<button class=\"cmp-lnk bad\" onclick=\"CMP.anularOC(\\'' + o.id + '\\')\">Anular</button>' : '') + '</div></td></tr>';",
  "    }).join('');",
  "    return '<div class=\"cmp-filtros\">' + chips + '<input class=\"cmp-buscar\" placeholder=\"Buscar por orden, proveedor, NIT…\" value=\"' + esc(V.bOC) + '\" oninput=\"CMP.buscar(\\'bOC\\',this.value)\"></div>' +",
  "      '<div class=\"cmp-tabla-w\"><table class=\"cmp-tabla\"><thead><tr><th>N° / Fecha</th><th>Proveedor</th><th>Solicitud</th><th>Total</th><th>Entrega</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>' +",
  "      (filas || '<tr><td colspan=\"7\"><div class=\"cmp-vacio\"><b>📄</b>No hay órdenes de compra' + (V.fOC || V.bOC ? ' con ese filtro' : '') + '.</div></td></tr>') + '</tbody></table></div>';",
  "  }",
  "",
  "  function verOC(id) {",
  "    var o = oc(id);",
  "    if (!o) { toast('No se encontró la orden', true); return; }",
  "    var s = sol(o.solicitud) || { id: o.solicitud, categoria: '', items: [] }, y = D.yo, p = prov(o.proveedorId) || {};",
  "    var esSolicitante = soy(s);",
  "    var cuerpo = '<div class=\"cmp-sec\">' + etapas(s, o) + '</div>';",
  "    cuerpo += accionesOC(o, s, y, esSolicitante);",
  "    cuerpo += '<div class=\"cmp-sec\"><h4>Orden de compra</h4><div class=\"cmp-kv\">' +",
  "      kv('Proveedor', esc(o.proveedor) + ' · NIT ' + esc(o.nit)) + kv('Solicitud', '<button class=\"cmp-lnk\" onclick=\"CMP.verSol(\\'' + s.id + '\\')\">' + esc(s.id) + '</button> · ' + esc(s.nombre || '')) +",
  "      kv('Fecha de emisión', fecha(o.fecha)) + kv('Entrega pactada', fecha(o.fechaEntrega) + ' (' + esc(o.diasEntrega) + ' días)') +",
  "      kv('Forma de pago', esc(o.formaPago)) + kv('Lugar de entrega', esc(o.lugarEntrega)) +",
  "      kv('Responsable', esc(o.responsable)) + kv('Concepto', esc(o.concepto)) +",
  "      kv('Seguimiento', esc(o.frecuenciaSeg)) + kv('Elaboró', esc(o.elaboro)) + kv('Observaciones', esc(o.observaciones), true) +",
  "      (o.autorizacion ? kv('Autorización de Gerencia', esc(o.autorizacion.por + ' · ' + o.autorizacion.motivo) + '<span class=\"cmp-sub\">Pendientes: ' + esc((o.autorizacion.pendientes || []).join('; ')) + '</span>', true) : '') +",
  "      '</div></div>';",
  "    cuerpo += '<div class=\"cmp-sec\"><h4>Ítems</h4><div class=\"cmp-tabla-w\"><table class=\"cmp-tabla\" style=\"min-width:0\"><thead><tr><th>Item</th><th>Cant.</th><th>Descripción</th><th>Lote</th><th>V. unitario</th><th>IVA</th><th>Valor IVA</th><th>Subtotal</th></tr></thead><tbody>' +",
  "      (o.items || []).map(function (i, k) {",
  "        var b = i.cantidad * i.valorUnitario;",
  "        return '<tr><td>' + (k + 1) + '</td><td>' + esc(i.cantidad) + '</td><td>' + esc(i.descripcion) + '</td><td>' + esc(i.lote || 'N/A') + '</td><td>' + pesos(i.valorUnitario) + '</td><td>' + esc(i.ivaPct) + '%</td><td>' + pesos(b * i.ivaPct / 100) + '</td><td>' + pesos(b) + '</td></tr>';",
  "      }).join('') + '</tbody></table></div><div class=\"cmp-tot\"><span>Subtotal ' + pesos(o.subtotal) + '</span><span>Descuento ' + pesos(o.descuento) + '</span><span>Total IVA ' + pesos(o.iva) + '</span><span>Total factura <b>' + pesos(o.total) + '</b></span></div>' +",
  "      '<div class=\"cmp-ayuda\" style=\"text-align:right;margin-top:4px\">' + esc(o.valorLetras || enLetras(o.total)) + '</div></div>';",
  "    cuerpo += bloqueContrato(o, y);",
  "    cuerpo += '<div class=\"cmp-sec\"><h4>Requisitos comunicados al proveedor</h4>' + bloqueRequisitos(s.requisitos) +",
  "      (o.requisitosCom ? '<div class=\"cmp-nota\" style=\"margin-top:10px\">Comunicados por <b>' + esc(o.requisitosCom.medio) + '</b> el ' + fecha(o.requisitosCom.fecha) + ' · ' + esc(o.requisitosCom.por) + ' · ' + enlace(o.requisitosCom.evidencia, 'Evidencia') + '</div>' : '') + '</div>';",
  "    var segs = D.seguimientos.filter(function (x) { return x.oc === o.id; }).sort(function (a, b) { return a.fecha < b.fecha ? 1 : -1; });",
  "    if (segs.length) cuerpo += '<div class=\"cmp-sec\"><h4>Seguimientos · ' + segs.length + '</h4><div class=\"cmp-tl\">' + segs.map(function (x) {",
  "      return '<div><b>' + esc(x.estado) + ' · ' + esc(x.comentario) + '</b><span>' + fecha(x.fecha) + ' · ' + esc(x.usuario) + (x.proxima ? ' · próximo ' + fecha(x.proxima) : '') + '</span></div>';",
  "    }).join('') + '</div></div>';",
  "    if (o.recepcion) {",
  "      var r = o.recepcion;",
  "      cuerpo += '<div class=\"cmp-sec\"><h4>Recepción y revisión ' + badgeEstado(r.conforme ? 'Cerrada' : 'En devolución').replace('Cerrada', 'Conforme') + '</h4><div class=\"cmp-kv\">' +",
