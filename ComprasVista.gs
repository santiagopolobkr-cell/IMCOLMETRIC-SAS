  "  function usuario() {",
  "    try { return (JSON.parse(localStorage.getItem('sesion')) || {}).usuario || ''; } catch (e) { return ''; }",
  "  }",
  "  function pesos(n) {",
  "    var v = Math.round(Number(n) || 0);",
  "    return '$' + String(Math.abs(v)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');",
  "  }",
  "  var MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];",
  "  function fecha(f) {",
  "    var s = String(f || '');",
