  "    var defs = D.config.documentos;",
  "    var docs = F.documentos.map(function (d) {",
  "      var x = (p.documentos || {})[d.doc] || {}, def = defs.filter(function (z) { return z.id === d.doc; })[0] || {};",
  "      var vigente = x.url && (!def.dias || (x.fecha && dias(x.fecha, hoy()) <= def.dias));",
  "      var pre = vigente ? 'SI' : (d.na && norm(p.tipoPersona) === 'natural' ? 'N/A' : '');",
