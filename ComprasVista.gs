  "    resultadoSel();",
  "  }",
  "  var TEXTO_CAT = { A: 'Primera opción para la compra', B: 'Segunda opción', C: 'Tercera opción', D: 'No comprar / no contratar', Excluido: 'No cumple los requisitos exigidos' };",
  "  function resultadoSel() {",
  "    var F = D.config.fo002, f = FORM.f2;",
  "    var pts = 0, todos = true;",
  "    F.puntajes.forEach(function (c) { var k = f.puntajes[c.id]; if (k === undefined) todos = false; else pts += c.ops[k][1]; });",
  "    var excluido = F.documentos.some(function (d) { return !d.noExcluye && f.documentos[d.id] === 'NO'; }) ||",
  "      Object.keys(f.grupos).some(function (g) { var x = f.grupos[g]; return x.aplica && Object.keys(x.items).some(function (i) { return x.items[i] === 'NO'; }); });",
  "    var d = chk('evD');",
