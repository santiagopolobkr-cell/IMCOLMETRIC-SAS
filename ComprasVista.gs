  "      if (ok) ok(o.data);",
  "    }).withFailureHandler(function (e) { (err || toast)(e && e.message ? e.message : String(e), true); });",
  "    r[fn].apply(r, args);",
  "  }",
  "  function cargar(cb) {",
  "    srv('cmpDatos', [usuario()], function (d) { D = d; pintar(); if (cb) cb(); }, function (e) {",
  "      CONT.innerHTML = '<div class=\"cmp\"><div class=\"cmp-card\"><div class=\"cmp-vacio\"><b>⚠</b>' + esc(e) + '</div></div></div>';",
