  "  }",
  "  function kv(etq, v, ancho) {",
  "    return '<div' + (ancho ? ' class=\"ancho\"' : '') + '><small>' + esc(etq) + '</small><span>' + (v === '' || v == null ? '—' : v) + '</span></div>';",
  "  }",
  "  function badgeEstado(e) {",
  "    var m = { 'Pendiente aprobación técnica': 'amar', 'En cotización': 'azul', 'Con orden de compra': 'teal', 'Rechazada': 'rojo', 'Anulada': 'gris',",
  "      'Emitida': 'mor', 'Enviada': 'azul', 'En seguimiento': 'azul', 'En devolución': 'rojo', 'Recibida': 'amar', 'Evaluada': 'teal', 'Cerrada': 'verde',",
  "      'Activo': 'verde', 'Inactivo': 'gris', 'Altamente confiable': 'verde', 'Confiable': 'azul', 'No confiable': 'rojo', 'Rehabilitado': 'teal' };",
  "    return '<span class=\"cmp-badge cmp-b-' + (m[e] || 'gris') + '\">' + esc(e || '—') + '</span>';",
