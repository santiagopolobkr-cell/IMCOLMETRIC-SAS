  "      return '<div class=\"cmp-f2g\" data-grupo=\"' + g.id + '\" style=\"margin-top:10px\"><div class=\"cmp-req\" style=\"background:#f8fafc;padding:8px 10px;border-radius:10px;border:none\"><b style=\"font-size:12px\">' + esc(g.t) + '</b>' +",
  "        '<div class=\"cmp-seg\"><button type=\"button\" class=\"si' + (aplica ? ' on' : '') + '\" onclick=\"CMP.f2Grupo(\\'' + g.id + '\\',true,this)\">Aplica</button><button type=\"button\" class=\"na' + (aplica ? '' : ' on') + '\" onclick=\"CMP.f2Grupo(\\'' + g.id + '\\',false,this)\">N/A</button></div></div>' +",
  "        '<div class=\"cmp-f2items\" style=\"padding:0 10px;' + (aplica ? '' : 'display:none') + '\">' + g.items.map(function (t, k) {",
  "          return '<div class=\"cmp-req\"><span>' + esc(t) + '</span>' + siNo('g:' + g.id, String(k), ['SI', 'NO'], '') + '</div>';",
  "        }).join('') + '</div></div>';",
  "    }).join('');",
  "    var punt = F.puntajes.map(function (c) {",
  "      return '<div class=\"cmp-crit\"><div class=\"cmp-crit-h\">' + esc(c.t) + '<span>Marque X · puntaje</span></div>' + c.ops.map(function (op, k) {",
  "        return '<button type=\"button\" class=\"cmp-f2op\" data-c=\"' + c.id + '\" onclick=\"CMP.f2Op(\\'' + c.id + '\\',' + k + ',this)\"><i></i><span>' + esc(op[0]) + '</span><b>' + op[1] + '</b></button>';",
  "      }).join('') + '</div>';",
  "    }).join('');",
  "    var cuerpo = '<div class=\"cmp-sec\"><h4>Datos de quien evalúa al proveedor</h4><div class=\"cmp-form\">' +",
  "      campo('Diligenciado por', '<input disabled value=\"' + esc(D.yo.nombre) + '\">') + campo('Cargo', '<input disabled value=\"' + esc(D.yo.cargo) + '\">') +",
  "      campo('Fecha de diligenciamiento', '<input type=\"date\" id=\"evFecha\" value=\"' + hoy() + '\">') +",
  "      campo('Motivo', '<select id=\"evMot\">' + opciones(['Evaluación inicial', 'Reevaluación anual', 'Reevaluación por cambio de condiciones', 'Nueva evaluación (proveedor No confiable)'], motivo) + '</select>', true) +",
