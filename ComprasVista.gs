  "  function catSel(c) {",
  "    if (!c) return '<span class=\"cmp-cat\" title=\"Sin evaluación\">–</span>';",
  "    return '<span class=\"cmp-cat ' + (c === 'Excluido' ? 'X' : esc(c)) + '\" title=\"Categoría de selección ' + esc(c) + '\">' + (c === 'Excluido' ? '✕' : esc(c)) + '</span>';",
  "  }",
  "  function enlace(url, txt) {",
