  "    return Number(s.slice(8, 10)) + ' ' + MESES[Number(s.slice(5, 7)) - 1] + ' ' + s.slice(0, 4) + (s.length > 10 ? ' · ' + s.slice(11, 16) : '');",
  "  }",
  "  function dias(a, b) {",
