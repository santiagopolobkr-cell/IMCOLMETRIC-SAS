  "    return Math.round((y - x) / 86400000);",
  "  }",
  "  function sumarDias(f, n) {",
  "    var d = new Date(String(f).slice(0, 10) + 'T00:00:00');",
  "    d.setDate(d.getDate() + n);",
  "    var p = function (x) { return (x < 10 ? '0' : '') + x; };",
  "    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());",
  "  }",
  "  function enLetras(n) {",
  "    n = Math.round(Number(n) || 0);",
  "    var U = ['', 'UN', 'DOS', 'TRES', 'CUATRO', 'CINCO', 'SEIS', 'SIETE', 'OCHO', 'NUEVE', 'DIEZ', 'ONCE', 'DOCE', 'TRECE', 'CATORCE', 'QUINCE',",
  "      'DIECISÉIS', 'DIECISIETE', 'DIECIOCHO', 'DIECINUEVE', 'VEINTE', 'VEINTIÚN', 'VEINTIDÓS', 'VEINTITRÉS', 'VEINTICUATRO', 'VEINTICINCO',",
  "      'VEINTISÉIS', 'VEINTISIETE', 'VEINTIOCHO', 'VEINTINUEVE'];",
  "    var DD = ['', '', '', 'TREINTA', 'CUARENTA', 'CINCUENTA', 'SESENTA', 'SETENTA', 'OCHENTA', 'NOVENTA'];",
  "    var C = ['', 'CIENTO', 'DOSCIENTOS', 'TRESCIENTOS', 'CUATROCIENTOS', 'QUINIENTOS', 'SEISCIENTOS', 'SETECIENTOS', 'OCHOCIENTOS', 'NOVECIENTOS'];",
  "    var cientos = function (x) {",
  "      if (x === 0) return '';",
  "      if (x === 100) return 'CIEN';",
  "      var c = Math.floor(x / 100), r = x % 100;",
  "      var dec = r < 30 ? U[r] : DD[Math.floor(r / 10)] + (r % 10 ? ' Y ' + U[r % 10] : '');",
  "      return (C[c] + ' ' + dec).trim();",
  "    };",
  "    if (n === 0) return 'CERO PESOS COLOMBIANOS (COP)';",
  "    if (n === 1) return 'UN PESO COLOMBIANO (COP)';",
  "    var mill = Math.floor(n / 1000000), miles = Math.floor((n % 1000000) / 1000), resto = n % 1000, partes = [];",
  "    if (mill) partes.push(mill === 1 ? 'UN MILLÓN' : (mill >= 1000 ? enLetras(mill).replace(' PESOS COLOMBIANOS (COP)', '') : cientos(mill)) + ' MILLONES');",
  "    if (miles) partes.push(miles === 1 ? 'MIL' : cientos(miles) + ' MIL');",
  "    if (resto) partes.push(cientos(resto));",
  "    return partes.join(' ') + (!miles && !resto && mill ? ' DE' : '') + ' PESOS COLOMBIANOS (COP)';",
  "  }",
  "  function hoy() { return D ? D.hoy : sumarDias(new Date().toISOString(), 0); }",
