const MTFO_MARCA = "Equipos según el control interno MT-FO-014 de la OT.";

function simularEquiposControlInterno() { return mtfoCargar_(true); }
function cargarEquiposControlInterno() { return mtfoCargar_(false); }

function mtfoCargar_(simular) {
  if (typeof RPC_ !== "undefined" && RPC_.activo) throw new Error("La carga solo se ejecuta desde el editor de Apps Script.");
  if (typeof ALM_HOJAS === "undefined" || typeof almHoja !== "function") throw new Error("El módulo de Almacén no está en el proyecto.");
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const ss = SpreadsheetApp.openById(typeof ALM_ID_HOJA !== "undefined" ? ALM_ID_HOJA : ID_HOJA);
    const mags = almMagnitudes(ss);
    const txt = v => String(v == null ? "" : v).trim();
    // ---- Hojas en bruto (se reescriben completas al final) ----
    const H = {};
    ["eq", "mov", "acta"].forEach(k => {
      const h = almHoja(ss, k), V = h.getDataRange().getValues();
      const enc = V[0].map(almNorm);
      if (!simular) ALM_HOJAS[k].cols.forEach(c => {    // columnas que falten (p. ej. N° CERTIFICADO en hojas antiguas)
        if (almColumna(enc, c) === -1) { h.getRange(1, enc.length + 1).setValue(c[1]).setFontWeight("bold"); enc.push(almNorm(c[1])); }
      });
      const ancho = enc.length;
      const filas = V.slice(1).filter(f => f.some(x => x !== "" && x !== null)).map(f => { f = f.slice(0, ancho); while (f.length < ancho) f.push(""); return f; });
      const pos = {};
      ALM_HOJAS[k].cols.forEach(c => { pos[c[0]] = almColumna(enc, c); });
      H[k] = { hoja: h, enc: enc, ancho: ancho, filas: filas, pos: pos, antes: V.length - 1 };
    });
    const g = (k, f, campo) => H[k].pos[campo] === -1 || H[k].pos[campo] === undefined ? "" : f[H[k].pos[campo]];
    const s = (k, f, campo, v) => { if (H[k].pos[campo] !== -1 && H[k].pos[campo] !== undefined) f[H[k].pos[campo]] = v; };

    const magDe = (equipo, codigo) => {
      const t = almNorm(equipo);
      const n = /humedad|higro|termohigr|datalog|ambiental/.test(t) ? "TEMPERATURA Y HUMEDAD RELATIVA"
        : /temperatura|termometr|termocupla|punzon|contacto|nevera|infrarr|pt100/.test(t) ? "TEMPERATURA DE CONTACTO"
        : /presion|manometr|vacuometr|tensiometr|esfigmo/.test(t) ? "PRESIÓN"
        : /masa|pesaje|balanza|bascula|ipfna/.test(t) ? "MASA"
        : /monitor|signos vitales/.test(t) ? "MONITOR SIGNOS VITALES"
        : /desfibril/.test(t) ? "DESFIBRILADOR"
        : /infusion/.test(t) ? "BOMBA DE INFUSIÓN"
        : /tallimetro|infantometro|longitud/.test(t) ? "LONGITUD" : "OTRAS MAGNITUDES";
      const m = almMagnitud(mags, n);
      // El color de la etiqueta sigue la sigla del código interno que asignó el laboratorio (CC-, TC-, P-, M-…)
      const sig = (txt(codigo).toUpperCase().match(/^[A-Z]+-/) || [""])[0];
      const porSigla = sig ? mags.find(x => x.sigla === sig && almNorm(x.magnitud) === almNorm(m.magnitud)) || mags.find(x => x.sigla === sig) : null;
      return { magnitud: m.magnitud, color: (porSigla || m).color };
    };

    const res = { ots: 0, equiposAntes: 0, equiposNuevos: 0, actas: 0, movimientos: 0, yaCargadas: [], aMano: [], noEstan: [], detalle: [] };
    let maxItem = H.eq.filas.reduce((m, f) => Math.max(m, Number(g("eq", f, "item")) || 0), 0);

    Object.keys(MTFO_EQUIPOS).forEach(ot => {
      const clave = almClaveOT(ot);
      const viejas = H.eq.filas.filter(f => almClaveOT(g("eq", f, "ot")) === clave);
      if (!viejas.length) { res.noEstan.push(ot); return; }
      if (viejas.some(f => txt(g("eq", f, "observaciones")).indexOf("MT-FO-014") !== -1)) { res.yaCargadas.push(ot); return; }
      const historica = f => /aproximadas|Importado de Drive/i.test(txt(g("eq", f, "observaciones"))) || /^Importaci[oó]n Drive/i.test(txt(g("eq", f, "actualizadoPor")));
      if (!viejas.every(historica)) { res.aMano.push(ot); return; }

      const base = viejas[0];
      const itemsViejos = viejas.map(f => Number(g("eq", f, "item")) || 0);
      const lista = MTFO_EQUIPOS[ot];
      const nuevas = lista.map(e => {
        const f = base.slice();
        const [equipo, marca, modelo, serie, inventario, codigo, cert, obs] = e;
        const m = magDe(equipo, codigo);
        const imc = [serie, inventario].find(x => /^IMC-\d+$/i.test(x)) || "";
        s("eq", f, "item", ++maxItem);
        s("eq", f, "equipo", equipo); s("eq", f, "marca", marca); s("eq", f, "modelo", modelo);
        s("eq", f, "serie", serie); s("eq", f, "inventario", inventario); s("eq", f, "identificacion", imc);
        s("eq", f, "magnitud", m.magnitud); s("eq", f, "codigoInterno", codigo); s("eq", f, "color", codigo ? m.color : "");
        s("eq", f, "certificado", cert);
        s("eq", f, "estadoFisico", codigo ? "BUENO" : "CON OBSERVACIONES");
        if (!codigo) s("eq", f, "descripcionActividad", "No se calibró");
        s("eq", f, "observaciones", MTFO_MARCA + (obs ? " " + obs.charAt(0) + obs.slice(1).toLowerCase() + "." : "").replace(/\.\.$/, "."));
        return f;
      });
      // Equipos: las filas nuevas ocupan el lugar de las genéricas
      const i0 = H.eq.filas.indexOf(base);
      H.eq.filas = H.eq.filas.filter(f => viejas.indexOf(f) === -1);
      H.eq.filas.splice(Math.min(i0, H.eq.filas.length), 0, ...nuevas);

      // Movimientos: cada equipo real recibe la misma secuencia (recepción, área técnica, retorno, despacho)
      const movViejos = H.mov.filas.filter(f => itemsViejos.indexOf(Number(g("mov", f, "item")) || 0) !== -1);
      const modelo = movViejos.filter(f => Number(g("mov", f, "item")) === itemsViejos[0]);
      const movNuevos = [];
      nuevas.forEach(f => {
        const it = g("eq", f, "item");
        modelo.forEach(mv => {
          const n = mv.slice();
          s("mov", n, "item", it);
          if (/^(Recepci[oó]n en almac[eé]n|Registro en sitio)/i.test(txt(g("mov", mv, "evento"))))
            s("mov", n, "detalle", [g("eq", f, "codigoInterno"), g("eq", f, "equipo"), "OT " + ot.toUpperCase(), "Estado " + g("eq", f, "estadoFisico")].filter(Boolean).join(" · "));
          movNuevos.push(n);
        });
      });
      const j0 = movViejos.length ? H.mov.filas.indexOf(movViejos[0]) : H.mov.filas.length;
      H.mov.filas = H.mov.filas.filter(f => movViejos.indexOf(f) === -1);
      H.mov.filas.splice(Math.min(j0, H.mov.filas.length), 0, ...movNuevos);

      // Acta de entrega: lista real de equipos con su certificado
      const idActa = txt(g("eq", base, "acta"));
      const acta = idActa ? H.acta.filas.find(f => txt(g("acta", f, "id")) === idActa) : null;
      if (acta) {
        s("acta", acta, "items", JSON.stringify(nuevas.map(f => ({ item: g("eq", f, "item"), producto: g("eq", f, "equipo"), marca: g("eq", f, "marca"),
          modelo: g("eq", f, "modelo"), cantidad: 1, serie: g("eq", f, "serie"), inventario: g("eq", f, "inventario"), certificado: g("eq", f, "certificado"),
          accesorios: "", codigoInterno: g("eq", f, "codigoInterno"), ot: ot.toUpperCase() }))));
        res.actas++;
      }
      res.ots++; res.equiposAntes += viejas.length; res.equiposNuevos += nuevas.length; res.movimientos += movNuevos.length;
      res.detalle.push(ot + ": " + viejas.length + " → " + nuevas.length + " equipos");
    });

    const texto = "Simulación: " + (simular ? "SÍ (no se escribió nada)" : "NO") +
      "\nOT actualizadas: " + res.ots + " · equipos genéricos reemplazados: " + res.equiposAntes + " → equipos reales: " + res.equiposNuevos +
      "\nActas de entrega con la lista real: " + res.actas + " · movimientos de los equipos: " + res.movimientos +
      (res.yaCargadas.length ? "\nYa estaban cargadas (no se tocan): " + res.yaCargadas.join(", ") : "") +
      (res.aMano.length ? "\nRegistradas a mano en el Almacén (no se tocan): " + res.aMano.join(", ") : "") +
      (res.noEstan.length ? "\nNo están en el Almacén (no se crean): " + res.noEstan.join(", ") : "") +
      "\n" + res.detalle.join("\n");
    Logger.log(texto);
    if (simular || !res.ots) return texto;

    // Escritura en bloque, con el mismo formato que almEscribir (los textos que parecen número o fecha quedan como texto)
    ["eq", "mov", "acta"].forEach(k => {
      const e = H[k], cItem = e.pos.item;
      const datos = e.filas.map(f => f.map((v, i) => typeof v === "string" && /^[0-9+\-=]/.test(v) && i !== cItem ? "'" + v : v));
      if (e.antes > 0) e.hoja.getRange(2, 1, e.antes, e.ancho).clearContent();
      if (datos.length) e.hoja.getRange(2, 1, datos.length, e.ancho).setValues(datos);
    });
    SpreadsheetApp.flush();
    return texto;
  } finally {
    lock.releaseLock();
  }
}
