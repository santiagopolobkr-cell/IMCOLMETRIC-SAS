function simularImportacionDrive() { return impDriveEjecutar_(true); }
function importarDesdeDrive() { return impDriveEjecutar_(false); }

function impDriveEjecutar_(simular) {
  if (typeof RPC_ !== "undefined" && RPC_.activo) throw new Error("La importación solo se ejecuta desde el editor de Apps Script.");
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const ss = SpreadsheetApp.openById(ID_HOJA);
    const H = {};
    ["VENTAS_SOLICITUDES", "VENTAS_EQUIPOS", "VENTAS_CLIENTES", "VENTAS_CONFORMIDAD", "VENTAS_HISTORIAL", "VENTAS_CONTRATOS", "VENTAS_REVISION"].forEach(n => {
      const h = ss.getSheetByName(n);
      if (!h) throw new Error("No existe la hoja " + n + ". Abre una vez el módulo de Ventas para que se cree.");
      const v = h.getDataRange().getValues();
      H[n] = { hoja: h, enc: v[0].map(x => String(x).trim()), filas: v.slice(1) };
    });
    const col = (n, c) => H[n].enc.indexOf(c);
    const val = (n, fila, c) => { const i = col(n, c); return i === -1 ? "" : fila[i]; };
    const nitBase = n => String(n == null ? "" : n).replace(/[^\d-]/g, "").split("-")[0].replace(/^0+/, "");
    const txt = v => String(v == null ? "" : v).trim();
    const fecha = s => { const m = String(s || "").match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : ""; };
    const actor = (function () { try { const u = Session.getActiveUser().getEmail(); return u ? "Importación Drive (" + u + ")" : "Importación Drive"; } catch (e) { return "Importación Drive"; } })();
    const ahora = new Date();

    // Consecutivos: el siguiente número por año, mirando todas las hojas que usan el ID de la solicitud
    const max = {};
    const verId = id => { const m = String(id || "").match(/^(\d{4})-(\d{3,})$/); if (m) max[m[1]] = Math.max(max[m[1]] || 0, Number(m[2])); };
    H.VENTAS_SOLICITUDES.filas.forEach(f => verId(val("VENTAS_SOLICITUDES", f, "ID")));
    ["VENTAS_EQUIPOS", "VENTAS_CONFORMIDAD", "VENTAS_HISTORIAL", "VENTAS_REVISION"].forEach(n => H[n].filas.forEach(f => verId(val(n, f, "ID_SOLICITUD"))));
    const nuevoId = anio => { max[anio] = (max[anio] || 0) + 1; return anio + "-" + ("000" + max[anio]).slice(-4); };

    // Lo que ya existe en Ventas (para no duplicar)
    const existentes = H.VENTAS_SOLICITUDES.filas.map((f, i) => ({ i: i, f: f, ot: txt(val("VENTAS_SOLICITUDES", f, "NUM_OT")).toUpperCase(),
      sc: txt(val("VENTAS_SOLICITUDES", f, "CONSECUTIVO_FO004")).toUpperCase(), nit: nitBase(val("VENTAS_SOLICITUDES", f, "CLIENTE_NIT")),
      cot: txt(val("VENTAS_SOLICITUDES", f, "NUM_COTIZACION_DOC")), id: txt(val("VENTAS_SOLICITUDES", f, "ID")) })).filter(x => x.id);
    const cotKey = c => { const m = String(c || "").match(/(20\d\d)-0*(\d+)/); return m ? m[1] + "-" + Number(m[2]) : ""; };
    const buscar = r => existentes.find(x => (r.ot && x.ot === r.ot.toUpperCase()) ||
      (r.sc && x.sc.indexOf(r.sc.toUpperCase()) !== -1 && x.nit === r.nitBase) ||
      (r.cot && x.cot && cotKey(x.cot) === cotKey(r.cot) && !r.ot && !r.sc));
    const contratos = {};
    H.VENTAS_CONTRATOS.filas.forEach(f => { const n = nitBase(val("VENTAS_CONTRATOS", f, "CLIENTE_NIT")); if (n && txt(val("VENTAS_CONTRATOS", f, "ESTADO")) !== "Inactivo") contratos[n] = val("VENTAS_CONTRATOS", f, "NUM_CONTRATO"); });
    const clientesExist = {};
    H.VENTAS_CLIENTES.filas.forEach(f => { const n = nitBase(val("VENTAS_CLIENTES", f, "NIT")); if (n) clientesExist[n] = true; });

    const filas = { VENTAS_SOLICITUDES: [], VENTAS_EQUIPOS: [], VENTAS_CLIENTES: [], VENTAS_CONFORMIDAD: [], VENTAS_HISTORIAL: [] };
    const fila = (n, o) => H[n].enc.map(c => o[c] === undefined || o[c] === null ? "" : o[c]);
    const resumen = { nuevas: 0, completadas: 0, sinCambios: 0, equipos: 0, clientes: 0, conformidad: 0, porEstado: {} };

    // Clientes nuevos
    IMP_DRIVE_DATOS.clientes.forEach(c => {
      const n = nitBase(c.nit);
      if (!n || clientesExist[n]) return;
      clientesExist[n] = true; resumen.clientes++;
      filas.VENTAS_CLIENTES.push(fila("VENTAS_CLIENTES", { NIT: c.nit, NOMBRE: c.nombre, TIPO_CLIENTE: c.tipo, CONTACTO: c.contacto, TELEFONO: c.telefono,
        CORREO: c.correo, DIRECCION: c.direccion, CIUDAD: c.ciudad, CORREO_FACTURACION: c.correoFact, F_REGISTRO: ahora, OBSERVACIONES: IMP_DRIVE_MARCA }));
    });

    IMP_DRIVE_DATOS.solicitudes.forEach(r => {
      const conOT = !!r.ot, conSC = !!r.sc;
      // Todo lo importado es histórico: queda cerrado. Con OT = cerrada por venta; sin OT = cerrada por desistimiento
      const estado = conOT ? "Cerrada por venta" : "Cerrada por desistimiento";
      const fCierre = fecha(r.fechaOT || r.fechaCot || r.fecha);
      const motivo = conOT ? "Servicio ejecutado con la " + r.ot + " (histórico importado de Drive)."
        : (conSC ? "Solicitud del cliente sin OT asociada en Drive (histórico importado)." : "Cotización sin OT asociada en Drive (histórico importado).");
      const obs = [IMP_DRIVE_MARCA,
        r.ot ? "OT " + r.ot + " (GCV-FO-002): " + r.urlOT : "",
        r.sc ? "Solicitud " + r.sc + " (GCV-FO-004)" : "",
        r.cot ? "Cotización " + r.cot + " (GCV-FO-003): " + (r.urlCot || "sin archivo") : "",
        r.contrato ? "Acuerdo/contrato: " + r.contrato : "",
        r.fechaAprox ? "Fecha aproximada (fecha del archivo en Drive)." : "",
        r.notaNit || "",
        r.equipos.length ? "" : (conSC ? "Equipos: ver el listado adjunto en la solicitud del cliente." : ""),
        (r.otrosDocs || []).length ? "Otros documentos del cliente: " + r.otrosDocs.join(" ") : ""].filter(Boolean).join(" | ");
      const v = {
        VERSION: 1, FECHA_RECEPCION: fecha(r.fecha), CANAL: "Correo electrónico", CLIENTE_NIT: r.nit || "N/R", CLIENTE: r.cliente, CONTACTO: r.contacto,
        TELEFONO_CONTACTO: r.telefono, CORREO_CONTACTO: r.correo, TIPO_CLIENTE: r.tipoCliente, COMERCIAL: actor, ESTADO: estado,
        REFERENCIA: r.ref || (conOT ? "Calibración" : ""), LUGAR_SERVICIO: r.lugar,
        VALOR_SUBTOTAL: r.subtotal == null ? "" : r.subtotal, VALOR_IVA: r.iva == null ? "" : r.iva, VALOR_TOTAL: r.total == null ? "" : r.total,
        F_COTIZADA: fecha(r.fechaCot), F_ACEPTADA: conOT ? fecha(r.fechaOT) : "", F_SOLICITUD_CAL: conOT ? fecha(r.fechaOT) : (conSC ? fecha(r.fecha) : ""),
        CONSECUTIVO_FO004: r.sc, F_CIERRE: fCierre, TIPO_CIERRE: conOT ? "Venta" : "Desistimiento", MOTIVO_CIERRE: motivo,
        TIPO_ACEPTACION: conOT ? (r.contrato ? "Contrato" : "Orden de servicio") : "",
        NUM_CONTRATO: r.contrato && contratos[r.nitBase] ? contratos[r.nitBase] : "",
        NUM_OT: r.ot, ACT_FO003: conOT ? "NO APLICA (OT importada)" : "", REVISION_CONTRATO_REABIERTA: "NO",
        URL_SOLICITUD_CLIENTE: r.urlSC || r.urlOT, OBSERVACIONES: obs, CREADO_POR: actor, F_CREACION: ahora, F_ACTUALIZACION: ahora,
        TERCERIZADO: "NO", ALCANCE_LAB: "SI", TERCERIZADO_A_IMC: r.tercerizadoImc || "NO",
        URL_COTIZACION: r.urlCot, NUM_COTIZACION_DOC: r.cot, VALOR_COTIZACION: r.total == null ? "" : r.total
      };
      const ex = buscar(r);
      if (ex) {
        // Ya existe: solo se completan las casillas vacías (no se cambia el estado ni lo que el usuario registró)
        let cambios = 0;
        ["NUM_OT", "CONSECUTIVO_FO004", "NUM_COTIZACION_DOC", "URL_COTIZACION", "VALOR_COTIZACION", "F_COTIZADA", "F_ACEPTADA", "F_SOLICITUD_CAL",
         "URL_SOLICITUD_CLIENTE", "TIPO_ACEPTACION", "NUM_CONTRATO", "ACT_FO003", "VALOR_SUBTOTAL", "VALOR_IVA", "VALOR_TOTAL"].forEach(c => {
          const i = col("VENTAS_SOLICITUDES", c);
          if (i === -1 || v[c] === "" || v[c] == null) return;
          const actual = ex.f[i];
          const vacio = actual === "" || actual == null || (typeof actual === "number" && actual === 0 && /^VALOR/.test(c));
          if (vacio && String(v[c]) !== String(actual)) { ex.f[i] = v[c]; cambios++; }
        });
        // Cerrar también las que ya estaban en Ventas o se importaron antes
        const est = String(val("VENTAS_SOLICITUDES", ex.f, "ESTADO"));
        if (!/^Cerrada/i.test(est)) {
          [["ESTADO", estado], ["F_CIERRE", fCierre], ["TIPO_CIERRE", v.TIPO_CIERRE], ["MOTIVO_CIERRE", motivo], ["F_ACTUALIZACION", ahora]].forEach(([c, x]) => {
            const i = col("VENTAS_SOLICITUDES", c); if (i !== -1) ex.f[i] = x; });
          cambios++; resumen.cerradas = (resumen.cerradas || 0) + 1;
          filas.VENTAS_HISTORIAL.push(fila("VENTAS_HISTORIAL", { FECHA: ahora, ID_SOLICITUD: ex.id, USUARIO: actor, ACCION: "Cierre (histórico importado de Drive)",
            ESTADO_ANTERIOR: est, ESTADO_NUEVO: estado, OBSERVACION: motivo, POSTERIOR_INICIO_TRABAJO: "NO" }));
        }
        if (cambios) {
          resumen.completadas++; ex.cambio = true;
          filas.VENTAS_HISTORIAL.push(fila("VENTAS_HISTORIAL", { FECHA: ahora, ID_SOLICITUD: ex.id, USUARIO: actor, ACCION: "Datos completados desde Drive",
            ESTADO_ANTERIOR: val("VENTAS_SOLICITUDES", ex.f, "ESTADO"), ESTADO_NUEVO: val("VENTAS_SOLICITUDES", ex.f, "ESTADO"), OBSERVACION: obs, POSTERIOR_INICIO_TRABAJO: "NO" }));
        } else resumen.sinCambios++;
        return;
      }
      const anio = (r.fecha || "").slice(0, 4) || String(ahora.getFullYear());
      const id = nuevoId(anio);
      v.ID = id;
      resumen.nuevas++; resumen.porEstado[estado] = (resumen.porEstado[estado] || 0) + 1;
      filas.VENTAS_SOLICITUDES.push(fila("VENTAS_SOLICITUDES", v));
      existentes.push({ id: id, ot: (r.ot || "").toUpperCase(), sc: (r.sc || "").toUpperCase(), nit: r.nitBase, cot: r.cot, f: [] });
      r.equipos.forEach((e, k) => {
        resumen.equipos++;
        filas.VENTAS_EQUIPOS.push(fila("VENTAS_EQUIPOS", { ID_EQUIPO: id + "-E" + ("00" + (k + 1)).slice(-3), ID_SOLICITUD: id, ITEM: k + 1, EQUIPO: e.equipo,
          MARCA: e.marca, MODELO: e.modelo, SERIE: e.serie, CODIGO_INVENTARIO: e.codigo, UBICACION: e.ubicacion, PUNTOS_CALIBRACION: e.puntos,
          TIPO_SERVICIO: "Propio", CANTIDAD: 1, VALOR_UNITARIO: 0, IVA_PCT: 19, ESTADO_EQUIPO: "", OBSERVACIONES: IMP_DRIVE_MARCA }));
      });
      if (conSC && r.conformidad) {
        resumen.conformidad++;
        const si = r.conformidad === "SI";
        filas.VENTAS_CONFORMIDAD.push(fila("VENTAS_CONFORMIDAD", { ID_SOLICITUD: id, SOLICITA_DECLARACION: si ? "SÍ" : "NO",
          NORMA_ESPECIFICACION: si ? (r.docConf || "Según fabricante") : "N/A", REGLA_DECISION: si ? (r.regla || "Aceptación Simple") : "N/A",
          VALIDACION: si ? "No requiere validación U/EMP" : "", ACEPTADA_POR_CLIENTE: "", FECHA: ahora, USUARIO: actor }));
      }
      filas.VENTAS_HISTORIAL.push(fila("VENTAS_HISTORIAL", { FECHA: ahora, ID_SOLICITUD: id, USUARIO: actor, ACCION: "Importación desde Drive",
        ESTADO_ANTERIOR: "", ESTADO_NUEVO: estado, OBSERVACION: obs, POSTERIOR_INICIO_TRABAJO: "NO" }));
    });

    const texto = "Simulación: " + (simular ? "SÍ (no se escribió nada)" : "NO") +
      "\nSolicitudes nuevas: " + resumen.nuevas + " " + JSON.stringify(resumen.porEstado) +
      "\nSolicitudes existentes cerradas ahora: " + (resumen.cerradas || 0) +
      "\nSolicitudes existentes completadas: " + resumen.completadas + " · sin cambios: " + resumen.sinCambios +
      "\nClientes nuevos: " + resumen.clientes + " · Equipos: " + resumen.equipos + " · Conformidad: " + resumen.conformidad +
      "\nConsecutivos asignados: " + JSON.stringify(max);
    Logger.log(texto);
    if (simular) return texto;

    Object.keys(filas).forEach(n => {
      const l = filas[n]; if (!l.length) return;
      const h = H[n].hoja;
      h.getRange(h.getLastRow() + 1, 1, l.length, H[n].enc.length).setValues(l);
    });
    // Casillas completadas en solicitudes existentes
    existentes.filter(x => x.cambio).forEach(x => H.VENTAS_SOLICITUDES.hoja.getRange(x.i + 2, 1, 1, H.VENTAS_SOLICITUDES.enc.length).setValues([x.f]));
    return texto;
  } finally {
    lock.releaseLock();
  }
}
