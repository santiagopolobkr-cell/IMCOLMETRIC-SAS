  "",
  "  // ---------- Equipos ----------",
  "  function filtrados() {",
  "    var b = norm(V.busca);",
  "    return D.equipos.filter(function (e) {",
  "      if (V.sit === 'custodia' && !enCustodia(e)) return false;",
  "      if (V.sit === 'desviacion' && !(enCustodia(e) && e.estadoFisico && e.estadoFisico !== 'BUENO')) return false;",
  "      if (V.sit && ['custodia', 'todos', 'desviacion'].indexOf(V.sit) === -1 && e.situacion !== V.sit) return false;",
  "      if (V.mag && norm(e.magnitud) !== norm(V.mag)) return false;",
  "      if (V.ubi && (e.ubicacion || 'Sin ubicación') !== V.ubi) return false;",
  "      if (b && norm([e.item, e.codigoInterno, e.identificacion, e.equipo, e.marca, e.modelo, e.serie, e.inventario, e.cliente, e.nit, e.ot, e.oc,",
  "        e.ubicacion, e.certificado, e.acta, e.recepcion].join(' ')).indexOf(b) === -1) return false;",
  "      return true;",
  "    }).sort(function (a, b) { return Number(b.item) - Number(a.item); });",
  "  }",
  "  function vistaEquipos() {",
  "    var cnt = function (s) { return D.equipos.filter(function (e) { return e.situacion === s; }).length; };",
  "    var chips = [['custodia', 'En custodia', D.equipos.filter(enCustodia).length]].concat(D.config.situaciones.map(function (s) { return [s, s, cnt(s)]; }))",
  "      .concat([['desviacion', 'Con observaciones', D.equipos.filter(function (e) { return enCustodia(e) && e.estadoFisico && e.estadoFisico !== 'BUENO'; }).length], ['todos', 'Todos', D.equipos.length]]);",
  "    var magsUsadas = D.equipos.map(function (e) { return e.magnitud; }).filter(function (m, i, a) { return m && a.indexOf(m) === i; }).sort();",
  "    return '<div class=\"alm-filtros\">' + chips.map(function (c) {",
  "        return '<button class=\"alm-chip' + (V.sit === c[0] ? ' on' : '') + '\" onclick=\"ALM.filtro(\\'sit\\',\\'' + c[0] + '\\')\">' + esc(c[1]) + '<em>' + c[2] + '</em></button>';",
  "      }).join('') + '</div>' +",
  "      '<div class=\"alm-filtros\"><input class=\"alm-buscar\" placeholder=\"🔎 Buscar por código, serie, cliente, OT, orden de servicio, contrato, ubicación...\" value=\"' + esc(V.busca) + '\" oninput=\"ALM.buscar(this.value)\">' +",
  "      '<select class=\"alm-sel\" onchange=\"ALM.filtro(\\'mag\\',this.value)\">' + opciones(magsUsadas, V.mag, 'Todas las magnitudes') + '</select>' +",
  "      (V.ubi ? '<button class=\"alm-chip on\" onclick=\"ALM.filtro(\\'ubi\\',\\'\\')\">📍 ' + esc(V.ubi) + ' ✕</button>' : '') +",
  "      '<span style=\"flex:1\"></span><button class=\"alm-btn sm\" onclick=\"ALM.imprimirFO001()\">🖨 CS-FO-001</button>' +",
  "      '<button class=\"alm-btn sm\" onclick=\"ALM.imprimirFO014()\">🖨 MT-FO-014</button><button class=\"alm-btn sm pri\" onclick=\"ALM.tab(\\'recepcion\\')\">＋ Recibir</button></div>' +",
  "      '<div class=\"alm-barra\" id=\"almBarra\"></div>' +",
  "      '<div class=\"alm-tabla-w\"><table class=\"alm-tabla\"><thead><tr><th><input type=\"checkbox\" id=\"almTodos\" onclick=\"ALM.selTodos(this.checked)\"></th>' +",
  "      '<th>Ítem</th><th>Código interno</th><th>Equipo</th><th>Serie / Inventario</th><th>Cliente</th><th>OT / Soporte</th><th>Recepción</th>' +",
  "      '<th>Estado físico</th><th>Ubicación</th><th>Situación</th><th>Adjuntos</th></tr></thead><tbody id=\"almTbody\"></tbody></table></div>';",
  "  }",
  "  function pintarTablaEquipos() {",
  "    var lista = filtrados(), tb = document.getElementById('almTbody');",
  "    if (!tb) return;",
  "    tb.innerHTML = lista.length ? lista.map(function (e) {",
  "      var r = recep(e.recepcion) || {};",
