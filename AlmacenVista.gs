  "        '<td onclick=\"event.stopPropagation()\">' + (adj || '<span class=\"alm-sub\">—</span>') + '</td></tr>';",
  "    }).join('') : '<tr><td colspan=\"12\"><div class=\"alm-vacio\"><b>📦</b>' + (D.equipos.length ? 'No hay equipos con estos filtros' : 'Aún no hay equipos recibidos. Usa «Recibir equipos».') + '</div></td></tr>';",
  "    pintarBarra();",
