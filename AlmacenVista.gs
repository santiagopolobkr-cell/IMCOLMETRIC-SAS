  "      estadoRetorno: val(p + 'Est'), certificado: val(p + 'Cert'), ubicacion: val(p + 'Ubi'), observaciones: val(p + 'Obs') }], msgDe(p), function () {",
  "      toast('Retorno registrado: listo para despacho'); cerrar(); cerrarModal(); V.sel = {}; cargar();",
