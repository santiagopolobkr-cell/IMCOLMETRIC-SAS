  "      '<button class=\"alm-lnk\" style=\"color:#93c5fd\" onclick=\"ALM.selNinguno()\">Quitar selección</button>';",
  "  }",
  "",
  "  // ---------- Detalle del equipo ----------",
  "  function verEquipo(item) {",
  "    var e = eq(item);",
  "    if (!e) return;",
  "    var m = mag(e.magnitud), r = recep(e.recepcion) || {}, a = e.acta ? acta(e.acta) : null;",
  "    var pasos = ((D.config.verificacion[m.grupo] || {}).pasos || []);",
  "    var ver = e.verificacion || {};",
  "    var etapas = [['Recepción', true], ['Almacén', true], ['Área técnica', !!e.fechaActividad], ['Retorno', !!e.fechaDevolucion], ['Despacho', e.situacion === 'Despachado']];",
  "    var actual = { 'En almacén': 1, 'En área técnica': 2, 'Listo para despacho': 4, 'En sitio': 0 }[e.situacion];",
  "    var movs = D.movimientos.filter(function (x) { return Number(x.item) === Number(item); }).reverse();",
  "    var acc = '';",
  "    if (!pu('crear')) { /* sin permiso para registrar movimientos: solo consulta */ }",
  "    else if (e.situacion === 'En almacén') {",
  "      acc = '<div class=\"alm-sec accion\"><h4>🔬 Salida al área técnica <span>5.1.2 A</span></h4><div class=\"alm-form\">' +",
  "        campo('Fecha de salida', '<input type=\"date\" id=\"dSalFecha\" value=\"' + D.hoy + '\">', true) +",
  "        campo('Responsable o técnico solicitante', '<input id=\"dSalResp\" list=\"almPersonal\" placeholder=\"Nombre\">', true, 'd2') + '</div>' +",
  "        '<div class=\"alm-msg\" id=\"dMsg\"></div><button class=\"alm-btn pri\" onclick=\"ALM.salida(this,[' + e.item + '],\\'dSal\\')\">Registrar salida</button></div>';",
  "    } else if (e.situacion === 'En área técnica') {",
  "      acc = '<div class=\"alm-sec accion\"><h4>↩️ Retorno a recepción técnica <span>5.1.2 B a E</span></h4>' + formRetornoHtml('dRet', e) +",
  "        '<div class=\"alm-msg\" id=\"dMsg\"></div><button class=\"alm-btn pri\" onclick=\"ALM.retorno(this,[' + e.item + '],\\'dRet\\')\">Registrar retorno</button></div>';",
  "    } else if (e.situacion === 'En sitio') {",
  "      acc = '<div class=\"alm-sec accion\"><h4>🏭 Equipo en sitio <span>5.2</span></h4><div class=\"alm-form\">' +",
  "        campo('Ubicación en almacén (si se retira)', '<input id=\"dSitUbi\" list=\"almUbis\" placeholder=\"Estante / canasta\">', false) +",
