  "        kv('Guía o acta de entrega', esc(e.guiaActa)) + (a ? kv('Acta firmada', a.actaFirmada ? enlace(a.actaFirmada, 'Ver acta') : 'Pendiente') +",
  "        kv('Comunicado al cliente', a.comunicado === 'SI' ? 'Sí · ' + fecha(a.fComunicado) : 'No') : '') + '</div>' +",
