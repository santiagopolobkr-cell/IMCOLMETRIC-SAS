  "</style>",
  "",
  "<script>",
  "(function () {",
  "  'use strict';",
  "",
  "  var D = null;",
  "  var V = { tab: 'tablero', sit: 'custodia', mag: '', busca: '', ubi: '', sel: {}, aBusca: '' };",
  "  var ARCH = {};",
  "  var SUBIENDO = 0;",
  "  var CONT = null;",
  "  var REC = null;   // formulario de recepción en curso",
  "  var LOGO = 'data:image/jpeg;base64,';",
  "  var VERSIONES = { 'CS-FO-001': 'V0.06.2025', 'CS-FO-003': 'V1.10.2026', 'MT-FO-014': 'V1.10.2025' };",
  "  var CUSTODIA = ['En almacén', 'En área técnica', 'Listo para despacho'];",
  "",
  "  // ---------- utilidades ----------",
  "  function esc(v) {",
  "    return String(v == null ? '' : v).replace(/[&<>\"']/g, function (c) {",
  "      return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '\"' ? '&quot;' : '&#39;';",
  "    });",
  "  }",
  "  function usuario() {",
  "    try { return (JSON.parse(localStorage.getItem('sesion')) || {}).usuario || ''; } catch (e) { return ''; }",
  "  }",
  "  var MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];",
  "  function fecha(f) {",
  "    var s = String(f || '');",
  "    if (!/^\\d{4}-\\d{2}-\\d{2}/.test(s)) return esc(s || '—');",
  "    return Number(s.slice(8, 10)) + ' ' + MESES[Number(s.slice(5, 7)) - 1] + ' ' + s.slice(0, 4) + (s.length > 10 ? ' · ' + s.slice(11, 16) : '');",
  "  }",
  "  function fechaDMY(f) {",
  "    var s = String(f || '');",
  "    return /^\\d{4}-\\d{2}-\\d{2}/.test(s) ? s.slice(8, 10) + '/' + s.slice(5, 7) + '/' + s.slice(0, 4) : s;",
  "  }",
  "  function dias(a, b) {",
  "    var x = new Date(String(a).slice(0, 10) + 'T00:00:00'), y = new Date(String(b).slice(0, 10) + 'T00:00:00');",
  "    return Math.round((y - x) / 86400000);",
  "  }",
  "  function val(id) { var e = document.getElementById(id); return e ? String(e.value || '').trim() : ''; }",
  "  function norm(v) { return String(v || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }",
  "  function opciones(lista, actual, vacio) {",
  "    return (vacio !== undefined ? '<option value=\"\">' + esc(vacio) + '</option>' : '') + lista.map(function (o) {",
  "      var v = typeof o === 'string' ? o : o.v, t = typeof o === 'string' ? o : o.t;",
  "      return '<option value=\"' + esc(v) + '\"' + (String(v) === String(actual) ? ' selected' : '') + '>' + esc(t) + '</option>';",
  "    }).join('');",
  "  }",
  "  function campo(etq, html, req, clase, ayuda) {",
  "    return '<div class=\"alm-f' + (clase ? ' ' + clase : '') + '\"><label>' + etq + (req ? ' <i>*</i>' : '') + '</label>' + html +",
  "      (ayuda ? '<div class=\"alm-ayuda\">' + ayuda + '</div>' : '') + '</div>';",
  "  }",
  "  function kv(etq, v, ancho) {",
  "    return '<div' + (ancho ? ' class=\"ancho\"' : '') + '><small>' + esc(etq) + '</small><span>' + (v === '' || v == null ? '—' : v) + '</span></div>';",
  "  }",
  "  function mag(nombre) {",
  "    var m = (D.magnitudes || []).filter(function (x) { return norm(x.magnitud) === norm(nombre); })[0];",
  "    return m || { magnitud: nombre || '', sigla: 'MG-', color: 'Rojo', hex: '#dc2626', grupo: 'biomedico' };",
  "  }",
  "  function hexColor(color) { return (D.config.colores || {})[color] || '#94a3b8'; }",
  "  function dot(color) { return '<span class=\"alm-dot\" style=\"background:' + hexColor(color) + '\" title=\"Etiqueta ' + esc(color || '') + '\"></span>'; }",
  "  function codigo(e) { return '<span class=\"alm-cod\">' + dot(e.color) + esc(e.codigoInterno) + '</span>'; }",
  "  function eq(item) { return D.equipos.filter(function (e) { return Number(e.item) === Number(item); })[0]; }",
  "  function acta(id) { return D.actas.filter(function (a) { return a.id === id; })[0]; }",
  "  function recep(id) { return D.recepciones.filter(function (r) { return r.id === id; })[0]; }",
  "  function badgeSit(s) {",
  "    var m = { 'En almacén': 'azul', 'En área técnica': 'mor', 'Listo para despacho': 'amar', 'Despachado': 'verde', 'En sitio': 'teal' };",
  "    return '<span class=\"alm-badge alm-b-' + (m[s] || 'gris') + '\">' + esc(s || '—') + '</span>';",
  "  }",
  "  function badgeEstado(s) {",
  "    var m = { 'BUENO': 'verde', 'CON OBSERVACIONES': 'amar', 'INOPERANTE': 'rojo' };",
  "    return s ? '<span class=\"alm-badge alm-b-' + (m[s] || 'gris') + '\">' + esc(s) + '</span>' : '—';",
  "  }",
  "  // \"Contrato CT-45\" o \"Por OT\" según el soporte del servicio",
  "  function soporteTxt(x) {",
  "    return x.soporte === 'Contrato' ? 'Contrato ' + (x.oc || '—') : 'Por OT';",
  "  }",
  "  // OT comparables: \"OT-050-26\" y \"OT050-26\" son la misma",
  "  function claveOT(ot) { return norm(ot).replace(/[^a-z0-9]/g, ''); }",
  "  // Permisos del usuario en el Almacén (crear / editar / eliminar)",
  "  function pu(a) { return !D.yo.puede || !!D.yo.puede[a]; }",
  "  function idEquipo(e) { return e.serie || e.inventario || e.identificacion || '—'; }",
  "  function enCustodia(e) { return CUSTODIA.indexOf(e.situacion) !== -1; }",
  "  function enlace(url, txt) {",
  "    if (!url) return '—';",
  "    return '<button type=\"button\" class=\"alm-adj\" onclick=\"event.stopPropagation();ALM.verArchivo(\\'' + esc(url) + '\\',\\'' + esc(txt || 'Archivo') + '\\')\">📎 ' + esc(txt || 'Ver') + '</button>';",
  "  }",
  "",
  "  // ---------- servidor ----------",
  "  function srv(fn, args, ok, err) {",
  "    var r = google.script.run.withSuccessHandler(function (res) {",
  "      var o;",
  "      try { o = JSON.parse(res); } catch (e) { o = { ok: false, error: String(res) }; }",
  "      if (!o.ok) { (err || toast)(o.error || 'Error', true); return; }",
  "      if (ok) ok(o.data);",
  "    }).withFailureHandler(function (e) { (err || toast)(e && e.message ? e.message : String(e), true); });",
  "    r[fn].apply(r, args);",
  "  }",
  "  function cargar(cb) {",
  "    srv('almDatos', [usuario()], function (d) { D = d; pintar(); if (cb) cb(); }, function (e) {",
  "      CONT.innerHTML = '<div class=\"alm\"><div class=\"alm-card\"><div class=\"alm-vacio\"><b>⚠</b>' + esc(e) + '</div></div></div>';",
  "    });",
  "  }",
  "  function accion(btn, fn, args, msgId, ok) {",
  "    if (SUBIENDO > 0) { mensaje(msgId, 'Espera a que termine de subir el archivo'); return; }",
  "    if (btn) btn.disabled = true;",
  "    mensaje(msgId, '');",
  "    srv(fn, [usuario()].concat(args), function (d) { if (btn) btn.disabled = false; ok(d); }, function (e) {",
  "      if (btn) btn.disabled = false;",
  "      if (msgId && document.getElementById(msgId)) mensaje(msgId, e); else toast(e, true);",
  "    });",
  "  }",
  "  function mensaje(id, t) { var e = id && document.getElementById(id); if (e) e.innerText = t || ''; }",
  "",
  "  // ---------- capas ----------",
  "  function asegurarCapas() {",
  "    if (document.getElementById('almDrawer')) return;",
  "    var html = '<div class=\"alm-fondo\" id=\"almFondo\" onclick=\"ALM.cerrar()\"></div><div class=\"alm-drawer\" id=\"almDrawer\"></div>' +",
  "      '<div class=\"alm-toast\" id=\"almToast\"></div><div class=\"alm-modal\" id=\"almModal\"><div class=\"alm-modal-b\" id=\"almModalB\"></div></div><div id=\"almPrint\"></div>';",
  "    var cont = document.createElement('div');",
  "    cont.innerHTML = html;",
  "    while (cont.firstChild) document.body.appendChild(cont.firstChild);",
  "  }",
  "  var toastT = null;",
  "  function toast(t, malo) {",
  "    var e = document.getElementById('almToast');",
  "    if (!e) { alert(t); return; }",
  "    e.innerText = t;",
  "    e.className = 'alm-toast ver' + (malo ? ' bad' : '');",
  "    clearTimeout(toastT);",
  "    toastT = setTimeout(function () { e.className = 'alm-toast'; }, malo ? 5200 : 3000);",
  "  }",
  "  function abrirDrawer(cab, cuerpo, pie, color) {",
  "    var d = document.getElementById('almDrawer');",
  "    d.innerHTML = '<div class=\"alm-dh\" style=\"--dc:' + (color || 'transparent') + '\">' + cab + '</div><div class=\"alm-db\">' + cuerpo + '</div>' + (pie ? '<div class=\"alm-df\">' + pie + '</div>' : '');",
  "    d.classList.add('ver');",
  "    document.getElementById('almFondo').classList.add('ver');",
  "    d.querySelector('.alm-db').scrollTop = 0;",
  "  }",
  "  function cabecera(num, titulo, tags) {",
  "    return '<div class=\"alm-dh-top\"><span class=\"alm-dh-num\">' + esc(num) + '</span><button class=\"alm-dh-x\" onclick=\"ALM.cerrar()\" aria-label=\"Cerrar\">✕</button></div>' +",
  "      '<h3>' + esc(titulo) + '</h3><div class=\"alm-dh-tags\">' + (tags || []).filter(Boolean).map(function (t) { return '<span>' + esc(t) + '</span>'; }).join('') + '</div>';",
  "  }",
  "  function cerrar() {",
  "    var d = document.getElementById('almDrawer'); if (d) d.classList.remove('ver');",
  "    var f = document.getElementById('almFondo'); if (f) f.classList.remove('ver');",
  "  }",
  "  function pedir(titulo, texto, etiqueta, cb) {",
  "    var b = document.getElementById('almModalB');",
  "    b.innerHTML = '<h3>' + esc(titulo) + '</h3><p>' + esc(texto) + '</p><textarea id=\"almPedir\" placeholder=\"' + esc(etiqueta) + '\"></textarea>' +",
  "      '<div class=\"alm-msg\" id=\"almPedirMsg\"></div><div style=\"display:flex;justify-content:flex-end;gap:8px\">' +",
  "      '<button class=\"alm-btn\" onclick=\"ALM.cerrarModal()\">Cancelar</button><button class=\"alm-btn bad\" id=\"almPedirOk\">Confirmar</button></div>';",
  "    document.getElementById('almModal').classList.add('ver');",
  "    document.getElementById('almPedirOk').onclick = function () {",
  "      var t = val('almPedir');",
  "      if (!t) { mensaje('almPedirMsg', 'Escribe el motivo'); return; }",
  "      cb(t, this);",
  "    };",
  "  }",
  "  function cerrarModal() { document.getElementById('almModal').classList.remove('ver'); }",
  "  function verArchivo(url, titulo) {",
  "    if (typeof window.verArchivoSD === 'function') window.verArchivoSD(url, titulo);",
  "    else window.open(url, '_blank', 'noopener');",
  "  }",
  "",
  "  // ---------- archivos ----------",
  "  function archivoW(id, url) {",
  "    ARCH[id] = url || '';",
  "    return '<div class=\"alm-file\" id=\"af_' + id + '\">' + archivoIn(id) + '</div>';",
  "  }",
  "  function archivoIn(id) {",
  "    var u = ARCH[id];",
  "    if (u === 'subiendo') return '<span class=\"sub\">Subiendo archivo…</span>';",
  "    return (u ? enlace(u, 'Ver archivo') + '<button type=\"button\" class=\"alm-lnk bad\" onclick=\"ALM.quitarArchivo(\\'' + id + '\\')\">Quitar</button>' : '') +",
  "      '<label class=\"alm-btn sm\">' + (u ? 'Reemplazar' : '📎 Adjuntar') + '<input type=\"file\" hidden onchange=\"ALM.subir(this,\\'' + id + '\\')\"></label>';",
  "  }",
  "  function pintarArchivo(id) { var e = document.getElementById('af_' + id); if (e) e.innerHTML = archivoIn(id); }",
  "  function subir(input, id) {",
  "    var f = input.files && input.files[0];",
  "    if (!f) return;",
  "    if (f.size > 10 * 1024 * 1024) { toast('El archivo supera 10 MB', true); return; }",
  "    var antes = ARCH[id];",
  "    ARCH[id] = 'subiendo'; SUBIENDO++; pintarArchivo(id);",
  "    var lector = new FileReader();",
  "    lector.onload = function () {",
  "      srv('almSubirArchivo', [f.name, f.type, String(lector.result).split(',')[1]], function (d) {",
  "        SUBIENDO--; ARCH[id] = d.url; pintarArchivo(id);",
  "      }, function (e) { SUBIENDO--; ARCH[id] = antes; pintarArchivo(id); toast(e, true); });",
  "    };",
  "    lector.readAsDataURL(f);",
  "  }",
  "",
  "  // ============================================================",
  "  // PANTALLA PRINCIPAL",
  "  // ============================================================",
  "  function pintar() {",
  "    var cust = D.equipos.filter(enCustodia).length;",
  "    var tabs = [['tablero', '📊 Tablero'], ['equipos', '📦 Equipos (CS-FO-001)', cust], ['recepcion', '📥 Recepción'],",
  "      ['actas', '📤 Despachos y actas (CS-FO-003)'], ['config', '⚙️ Magnitudes y etiquetas']];",
  "    CONT.innerHTML = '<div class=\"alm\">' +",
  "      '<div class=\"alm-hero\"><div class=\"alm-hero-txt\"><div class=\"alm-eyebrow\">Cadena de suministro · CS-PR-001</div>' +",
  "      '<h2>Almacén de equipos en servicio</h2><p>Recepción, almacenamiento temporal, identificación, control y despacho de los equipos recibidos para calibración o mantenimiento, con trazabilidad completa desde la recepción hasta la entrega.</p></div>' +",
  "      '<div class=\"alm-hero-acc\"><button class=\"alm-btn\" onclick=\"ALM.tab(\\'recepcion\\')\">📥 Recibir equipos</button>' +",
  "      '<button class=\"alm-btn ghost\" onclick=\"ALM.irSit(\\'Listo para despacho\\')\">📤 Despachar</button></div></div>' +",
  "      '<div class=\"alm-tabs\">' + tabs.map(function (t) {",
  "        return '<button class=\"alm-tab' + (V.tab === t[0] ? ' on' : '') + '\" onclick=\"ALM.tab(\\'' + t[0] + '\\')\">' + t[1] + (t[2] ? ' <b>' + t[2] + '</b>' : '') + '</button>';",
  "      }).join('') + '</div><div id=\"almVista\"></div></div>';",
  "    pintarVista();",
  "  }",
  "",
  "  function pintarVista() {",
  "    var v = document.getElementById('almVista');",
  "    if (!v) return;",
  "    if (V.tab === 'tablero') v.innerHTML = vistaTablero();",
  "    else if (V.tab === 'equipos') { v.innerHTML = vistaEquipos(); pintarTablaEquipos(); }",
  "    else if (V.tab === 'recepcion') { if (!REC) nuevaRecepcion(); v.innerHTML = vistaRecepcion(); }",
  "    else if (V.tab === 'actas') { v.innerHTML = vistaActas(); pintarTablaActas(); }",
  "    else if (V.tab === 'config') v.innerHTML = vistaConfig();",
  "  }",
  "",
  "  // ---------- Tablero ----------",
  "  function vistaTablero() {",
  "    var E = D.equipos, hoy = D.hoy;",
  "    var cuenta = function (s) { return E.filter(function (e) { return e.situacion === s; }).length; };",
  "    var mes = hoy.slice(0, 7);",
  "    var despMes = E.filter(function (e) { return e.situacion === 'Despachado' && String(e.fechaSalida).slice(0, 7) === mes; }).length;",
  "    var recMes = E.filter(function (e) { return String(e.fechaRecepcion).slice(0, 7) === mes; }).length;",
  "    var cust = E.filter(enCustodia);",
  "    var obs = cust.filter(function (e) { return e.estadoFisico && e.estadoFisico !== 'BUENO'; });",
  "    var prom = cust.length ? Math.round(cust.reduce(function (s, e) { return s + Math.max(0, dias(e.fechaRecepcion, hoy)); }, 0) / cust.length) : 0;",
  "    var kpi = function (t, n, d, color, onclick) {",
  "      return '<button class=\"alm-kpi\" style=\"--k:' + color + '\" onclick=\"' + onclick + '\"><small>' + t + '</small><b>' + n + '</b><span>' + d + '</span></button>';",
  "    };",
  "    var est = function (ico, t, d, n, sit) {",
  "      return '<button class=\"alm-est' + (n ? ' act' : '') + '\" onclick=\"ALM.irSit(\\'' + sit + '\\')\"><div class=\"alm-est-n\">' + ico + '</div>' +",
  "        (n ? '<span class=\"alm-est-i\">' + n + '</span>' : '') + '<div class=\"alm-est-t\">' + t + '</div><div class=\"alm-est-d\">' + d + '</div></button>';",
  "    };",
  "",
  "    // Magnitudes en custodia",
  "    var porMag = {};",
  "    cust.forEach(function (e) { var k = e.magnitud || 'Sin magnitud'; porMag[k] = porMag[k] || { n: 0, color: e.color }; porMag[k].n++; });",
  "    var mags = Object.keys(porMag).sort(function (a, b) { return porMag[b].n - porMag[a].n; });",
  "    var maxM = mags.length ? porMag[mags[0]].n : 1;",
  "    // Ubicaciones",
  "    var ubis = {};",
  "    E.filter(function (e) { return e.situacion === 'En almacén' || e.situacion === 'Listo para despacho'; }).forEach(function (e) {",
  "      var k = e.ubicacion || 'Sin ubicación'; ubis[k] = ubis[k] || []; ubis[k].push(e);",
  "    });",
  "    // Alertas",
  "    var al = [];",
  "    var listosViejos = E.filter(function (e) { return e.situacion === 'Listo para despacho' && dias(e.fechaDevolucion || e.fechaRecepcion, hoy) > 3; });",
  "    if (listosViejos.length) al.push(['⏰', '#fef3c7', listosViejos.length + ' equipo(s) listos para despacho hace más de 3 días', 'Coordinar la entrega con el cliente', 'ALM.irSit(\\'Listo para despacho\\')']);",
  "    var sinInstr = cust.filter(function (e) { return e.estadoFisico && e.estadoFisico !== 'BUENO' && !e.instruccionCliente; });",
  "    if (sinInstr.length) al.push(['📞', '#fee2e2', sinInstr.length + ' equipo(s) con desviación sin instrucción del cliente', 'Consultar al cliente antes de proceder (5.1.1 D)', 'ALM.irFiltro(\\'desviacion\\')']);",
  "    var sinCom = D.actas.filter(function (a) { return a.estado !== 'Anulada' && a.comunicado !== 'SI'; });",
  "    if (sinCom.length) al.push(['✉️', '#dbeafe', sinCom.length + ' despacho(s) sin comunicar al cliente', 'El almacén debe garantizar la comunicación de la salida (5.1.3 B)', 'ALM.tab(\\'actas\\')']);",
  "    var sinGuia = D.actas.filter(function (a) { return a.estado !== 'Anulada' && /transportadora/i.test(a.medio) && !a.guiaArchivo; });",
  "    if (sinGuia.length) al.push(['🚚', '#ede9fe', sinGuia.length + ' despacho(s) por transportadora sin constancia de la guía', 'Adjuntar la guía de envío', 'ALM.tab(\\'actas\\')']);",
  "    var sinUbi = cust.filter(function (e) { return e.situacion === 'En almacén' && !e.ubicacion; });",
