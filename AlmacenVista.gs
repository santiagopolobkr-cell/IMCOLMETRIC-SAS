  "    var cuerpo = '<div class=\"alm-sec\"><div class=\"alm-etapas\">' + etapas.map(function (x, i) {",
  "        return '<div class=\"alm-et ' + (i === actual ? 'actual' : x[1] ? 'hecha' : '') + '\"><i>' + (x[1] && i !== actual ? '✓' : i + 1) + '</i>' + x[0] + '</div>';",
  "      }).join('') + '</div></div>' + acc +",
  "      '<div class=\"alm-sec\"><h4>Identificación <span><button class=\"alm-btn sm\" onclick=\"ALM.etiquetas([' + e.item + '])\">🏷 Imprimir etiqueta</button></span></h4><div class=\"alm-kv\">' +",
