  "    modalForm('✏️ Editar ' + esc(e.codigoInterno), 'Los códigos y la situación del equipo no cambian.', html, function (btn) {",
  "      accion(btn, 'almEditarEquipo', [item, { equipo: val('eEquipo'), marca: val('eMarca'), modelo: val('eModelo'), serie: val('eSerie'), inventario: val('eInv'),",
  "        estadoFisico: val('eEstado'), accesorios: val('eAcc'), limpieza: val('eLimp'), desviaciones: val('eDesv'), consultaCliente: val('eCons'),",
  "        aceptaDesviacion: val('eAcepta'), instruccionCliente: val('eInstr'), certificado: val('eCert'), observaciones: val('eObs'),",
  "        fotos: ARCH.eFotos || '', motivo: val('eMotivo') }], 'mMsg', function () { toast('Datos actualizados'); cerrarModal(); cargar(function () { verEquipo(item); }); });",
  "    });",
  "    document.getElementById('almModalB').style.width = 'min(820px,100%)';",
  "  }",
  "",
  "  // ============================================================",
  "  // RECEPCIÓN (5.1.1 / 5.2.1)",
  "  // ============================================================",
  "  function nuevoEquipo(base) {",
  "    base = base || {};",
  "    return { equipo: base.equipo || '', marca: base.marca || '', modelo: base.modelo || '', traeSerie: base.traeSerie || '', serie: base.serie || '', inventario: base.inventario || '',",
  "      magnitud: base.magnitud || '', actividad: base.actividad || 'CALIBRACIÓN', descripcionActividad: base.descripcionActividad || '',",
  "      estadoFisico: '', pasos: [], notas: '', accesorios: '', desviaciones: '', consultaCliente: '', instruccionCliente: '', aceptaDesviacion: '',",
  "      limpieza: '', ubicacion: '', observaciones: '' };",
  "  }",
  "  function nuevaRecepcion() {",
  "    REC = { fecha: D.hoy, hora: D.hora, modalidad: 'Laboratorio', ot: '', oc: '', soporte: 'Orden de trabajo', cliente: '', nit: '', idVentas: '', lugar: '',",
  "      entregaTipo: '', entregaNombre: '', transportadora: '', recibeLab: '', colaborador: '', constanciaTipo: '', constanciaNum: '', condAmbientales: '', observaciones: '', equipos: [nuevoEquipo()], hecho: null };",
  "    Object.keys(ARCH).forEach(function (k) { if (/^rec/.test(k)) delete ARCH[k]; });",
  "  }",
  "  function leerRecepcion() {",
  "    if (!REC || REC.hecho || !document.getElementById('rOt')) return;",
  "    ['fecha', 'hora', 'ot', 'oc', 'cliente', 'nit', 'lugar', 'entregaNombre', 'transportadora', 'recibeLab', 'colaborador', 'constanciaNum', 'condAmbientales', 'observaciones'].forEach(function (k) {",
  "      var el = document.getElementById('r_' + k) || document.getElementById('r' + k.charAt(0).toUpperCase() + k.slice(1));",
  "      if (el) REC[k] = String(el.value || '').trim();",
  "    });",
  "    REC.equipos.forEach(function (e, i) {",
  "      ['equipo', 'marca', 'modelo', 'serie', 'inventario', 'magnitud', 'actividad', 'descripcionActividad', 'accesorios', 'desviaciones',",
  "        'consultaCliente', 'instruccionCliente', 'aceptaDesviacion', 'limpieza', 'ubicacion', 'notas'].forEach(function (k) {",
  "        var el = document.getElementById('re' + i + '_' + k);",
  "        if (el) e[k] = String(el.value || '').trim();",
  "      });",
  "      var ps = document.querySelectorAll('[data-paso=\"' + i + '\"]');",
  "      e.pasos = Array.prototype.map.call(ps, function (c) { return c.checked; });",
  "    });",
  "  }",
  "  function ordenVentas(ot) {",
  "    return (D.ordenes || []).filter(function (o) { return claveOT(o.ot) === claveOT(ot); })[0];",
  "  }",
  "  function siguienteCodigoPreview(sigla, desplaza) {",
  "    var max = D.equipos.reduce(function (m, e) {",
  "      var c = String(e.codigoInterno || '').toUpperCase();",
  "      if (c.indexOf(sigla) !== 0) return m;",
  "      var n = parseInt(c.slice(sigla.length), 10);",
  "      return isNaN(n) ? m : Math.max(m, n);",
  "    }, 0);",
  "    return sigla + (max + 1 + (desplaza || 0));",
  "  }",
  "  function vistaRecepcion() {",
  "    if (REC.hecho) return vistaExito();",
  "    if (!pu('crear')) return '<div class=\"alm-card\"><div class=\"alm-vacio\"><b>🔒</b>No tienes permiso para registrar recepciones en el Almacén. Solicítalo al Administrador del sistema.</div></div>';",
  "    var R = REC, enSitio = R.modalidad === 'En sitio';",
  "    var ov = ordenVentas(R.ot);",
  "    var esContrato = R.soporte === 'Contrato';",
  "    var faltan = !R.ot || (esContrato && !R.oc);",
  "    var seg = function (id, lista, actual, fn) {",
  "      return '<div class=\"alm-seg\" id=\"' + id + '\">' + lista.map(function (x) {",
  "        return '<button type=\"button\" class=\"' + (actual === x ? 'on' : '') + '\" onclick=\"ALM.' + fn + '(\\'' + esc(x) + '\\')\">' + esc(x) + '</button>';",
  "      }).join('') + '</div>';",
  "    };",
  "    // Contador por sigla para mostrar el código que tendrá cada equipo, y de seriales IMC",
  "    var usados = {}, imcN = 0;",
  "    var html = '<div class=\"alm-paso\"><div class=\"alm-paso-h\"><i>1</i><div><b>Orden de trabajo y soporte comercial</b><span>Condiciones generales · los equipos deben llegar con OT y con orden de servicio y/o contrato asignados por el área comercial</span></div></div><div class=\"alm-paso-b\">' +",
  "      '<div style=\"margin-bottom:12px\">' + seg('rModalidad', ['Laboratorio', 'En sitio'], R.modalidad, 'recModalidad') +",
  "      '<span class=\"alm-ayuda\" style=\"margin-left:10px\">' + (enSitio ? '5.2 En sitio: se registra el equipo calibrado donde el cliente (MT-FO-022)' : '5.1 En el laboratorio') + '</span></div>' +",
  "      '<div class=\"alm-form\">' +",
  "      campo('Orden de trabajo (OT)', '<input id=\"rOt\" list=\"almOTs\" value=\"' + esc(R.ot) + '\" placeholder=\"Elige la OT, ej: OT101-26\" onchange=\"ALM.recOT(this.value)\">', true, '',",
  "        (D.ordenes.length ? D.ordenes.length + ' OT asignadas por Ventas (consecutivas, no se repiten)' : 'GCV-FO-002 · la asigna el área comercial')) +",
  "      '<div class=\"alm-f\"><label>Soporte del servicio <i>*</i></label>' + seg('rSoporte', D.config.soportes, R.soporte === 'Contrato' ? 'Contrato' : 'Orden de trabajo', 'recSoporte') + '</div>' +",
  "      (esContrato ? campo('N° de contrato', '<input id=\"rOc\" value=\"' + esc(R.oc) + '\" onchange=\"ALM.recCampo(\\'oc\\',this.value)\">', true)",
  "        : campo('Soporte', '<input value=\"La misma orden de trabajo' + (R.ot ? ' (' + esc(R.ot) + ')' : '') + '\" readonly>')) +",
  "      campo('Fecha y hora de recepción', '<div style=\"display:flex;gap:6px\"><input type=\"date\" id=\"rFecha\" value=\"' + esc(R.fecha) + '\"><input type=\"time\" id=\"rHora\" value=\"' + esc(R.hora) + '\" style=\"max-width:110px\"></div>', true) +",
  "      campo('Cliente', '<input id=\"rCliente\" value=\"' + esc(R.cliente) + '\"' + (ov ? ' readonly title=\"Tomado de la OT en Ventas\"' : '') + '>', true, 'd2') +",
  "      campo('NIT', '<input id=\"rNit\" value=\"' + esc(R.nit) + '\"' + (ov ? ' readonly title=\"Tomado de la OT en Ventas\"' : '') + '>') +",
  "      (enSitio ? campo('Lugar / dirección del cliente', '<input id=\"rLugar\" value=\"' + esc(R.lugar) + '\">', false, 'ancho') : '') + '</div>' +",
  "      (faltan ? '<div class=\"alm-nota bad\" style=\"margin-top:12px\">⛔ Los equipos sin OT' + (esContrato ? ' y sin contrato' : '') + ' <b>no se reciben bajo ninguna circunstancia</b>, al menos hasta que sean aprobadas. Comunícate con el cliente y/o el asesor comercial para iniciar o completar el proceso (5.1.1 B).' +",
  "        '</div>' : '') +",
  "      (R.ot && !ov && D.ordenes.length ? '<div class=\"alm-nota bad\" style=\"margin-top:12px\">⛔ La OT <b>' + esc(R.ot) + '</b> no existe en Ventas. La OT la asigna el área comercial en consecutivo y no se repite: elígela de la lista o solicítala al asesor comercial.</div>' : '') +",
  "      (ov ? '<div class=\"alm-nota ok\" style=\"margin-top:12px\">✓ OT encontrada en Ventas: <b>' + esc(ov.ot) + '</b> · ' + esc(ov.cliente) + (ov.oc ? ' · ' + esc(soporteTxt(ov)) : '') +",
  "        (ov.sinCotizacion ? ' · <b>orden de servicio por contrato (sin cotización)</b>' : '') +",
  "        ' · ' + ov.equipos.length + (ov.sinCotizacion ? ' equipo(s) en la orden' : ' equipo(s) cotizados') + (ov.equipos.length ? ' <button type=\"button\" class=\"alm-btn sm\" style=\"margin-left:8px\" onclick=\"ALM.recCargarOT()\">⬇ Cargar equipos de la OT</button>' : '') + '</div>' : '') +",
  "      '<datalist id=\"almOTs\">' + D.ordenes.map(function (o) { return '<option value=\"' + esc(o.ot) + '\">' + esc(o.cliente + (o.oc ? ' · ' + soporteTxt(o) : '')) + '</option>'; }).join('') + '</datalist>' +",
  "      '</div></div>';",
  "",
  "    if (!enSitio) {",
  "      var med = R.entregaTipo, cli = R.entregaNombre || R.cliente;",
  "      var campoCli = campo('Nombre del cliente', '<input id=\"rEntregaNombre\" value=\"' + esc(cli) + '\" placeholder=\"Cliente que entrega el equipo\">', true);",
  "      html += '<div class=\"alm-paso\"><div class=\"alm-paso-h\"><i>2</i><div><b>Medio por el cual llegan los equipos al laboratorio</b><span>5.1.1 A y C · quién trae el equipo y su soporte de entrega</span></div></div><div class=\"alm-paso-b\">' +",
  "        '<div style=\"margin-bottom:12px\">' + seg('rEntrega', D.config.medios, med, 'recEntrega') + '</div>' +",
  "        (!med ? '<div class=\"alm-ayuda\">Elige el medio para ver los datos que se deben registrar.</div>' :",
  "        '<div class=\"alm-form\">' +",
  "        (med === 'Cliente' ? campoCli +",
  "          campo('Quien recibe el equipo en el laboratorio', '<input id=\"rRecibeLab\" list=\"almPersonal\" value=\"' + esc(R.recibeLab) + '\" placeholder=\"Colaborador de IMCOLMETRIC\">', true) +",
  "          campo('Formato de recepción', archivoW('recConst', ARCH.recConst), true) : '') +",
  "        (med === 'Transportadora' ? campo('Nombre de la transportadora', '<input id=\"rTransportadora\" value=\"' + esc(R.transportadora) + '\" placeholder=\"Ej: Servientrega\">', true) + campoCli +",
  "          campo('Número de guía', '<input id=\"rConstanciaNum\" value=\"' + esc(R.constanciaNum) + '\">', true) +",
  "          campo('Adjuntar guía', archivoW('recConst', ARCH.recConst), true, 'ancho') : '') +",
  "        (med === 'Personal del laboratorio' ? campoCli +",
  "          campo('Colaborador de IMCOLMETRIC que trae el equipo', '<input id=\"rColaborador\" list=\"almPersonal\" value=\"' + esc(R.colaborador) + '\">', true, 'd2', 'No requiere documento soporte') : '') +",
  "        '</div>') + '</div></div>';",
  "    }",
  "",
  "    html += '<div class=\"alm-paso\"><div class=\"alm-paso-h\"><i>' + (enSitio ? 2 : 3) + '</i><div><b>Equipos recibidos</b><span>5.1.1 D a H · verificación física, desviaciones, limpieza, código interno, etiqueta y ubicación</span></div>' +",
  "      '<button type=\"button\" class=\"alm-btn sm\" style=\"margin-left:auto\" onclick=\"ALM.recMas()\">＋ Agregar equipo</button></div><div class=\"alm-paso-b\">' +",
  "      R.equipos.map(function (e, i) {",
  "        var m = e.magnitud ? mag(e.magnitud) : null;",
  "        var codPrev = m ? siguienteCodigoPreview(m.sigla, (usados[m.sigla] = (usados[m.sigla] || 0) + 1) - 1) : '';",
  "        var grupo = m ? D.config.verificacion[m.grupo] : null;",
  "        var imcPrev = e.traeSerie === 'NO' ? 'IMC-' + ('0000' + ((D.ultimoIMC || 0) + (imcN += 1))).slice(-5) : '';",
  "        var descs = (D.config.actividades[e.actividad] || []);",
  "        return '<div class=\"alm-eq\" style=\"--ec:' + (m ? m.hex : '#cbd5e1') + '\"><div class=\"alm-eq-h\"><b>Equipo ' + (i + 1) + '</b>' +",
  "          (m ? '<span class=\"alm-sticker\" style=\"--sc:' + m.hex + '\"><i></i>' + esc(codPrev) + ' · ' + esc(m.color) + '<span class=\"alm-sub\" style=\"margin:0 0 0 4px\">(se asigna al guardar)</span></span>' : '<span class=\"alm-sticker\"><i></i>Elige la magnitud para ver el código</span>') +",
  "          '<button type=\"button\" class=\"alm-btn sm\" title=\"Agregar otro equipo con esta misma información\" onclick=\"ALM.recCopiar(' + i + ')\">⧉ Copiar</button>' +",
  "          (R.equipos.length > 1 ? '<button type=\"button\" class=\"alm-x\" title=\"Quitar\" onclick=\"ALM.recMenos(' + i + ')\">✕</button>' : '') + '</div>' +",
  "          '<div class=\"alm-form\">' +",
  "          campo('Equipo', '<input id=\"re' + i + '_equipo\" value=\"' + esc(e.equipo) + '\" placeholder=\"Ej: Termohigrómetro\">', true) +",
