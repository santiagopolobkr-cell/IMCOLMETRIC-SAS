  "    abrirDrawer(cabecera(e.codigoInterno + ' · Ítem ' + e.item, e.equipo + (e.marca ? ' · ' + e.marca : ''), [e.situacion, e.cliente, e.ot, e.magnitud]), cuerpo, pie, hexColor(e.color));",
  "  }",
  "  function listas() {",
  "    var ubis = D.equipos.map(function (e) { return e.ubicacion; }).filter(function (u, i, a) { return u && a.indexOf(u) === i; });",
  "    return '<datalist id=\"almPersonal\">' + D.personal.map(function (p) { return '<option value=\"' + esc(p.nombre) + '\">' + esc(p.cargo) + '</option>'; }).join('') + '</datalist>' +",
  "      '<datalist id=\"almUbis\">' + ubis.map(function (u) { return '<option value=\"' + esc(u) + '\">'; }).join('') + '</datalist>';",
  "  }",
  "  function formRetornoHtml(p, e) {",
  "    var si = function (id) { return '<select id=\"' + p + id + '\">' + opciones(['SI', 'NO', 'N.A.'], '', 'Selecciona') + '</select>'; };",
  "    return '<div class=\"alm-form\">' + campo('Fecha de devolución', '<input type=\"date\" id=\"' + p + 'Fecha\" value=\"' + D.hoy + '\">', true) +",
  "      campo('¿Se verificaron/retiraron las etiquetas internas?', si('Etq'), true, '', 'Retirar los stickers propios del manejo interno (5.1.2 C)') +",
  "      campo('¿Accesorios completos?', si('Acc'), true) +",
  "      campo('Estado del equipo al retorno', '<select id=\"' + p + 'Est\">' + opciones(D.config.estados, '', 'Selecciona') + '</select>', true) +",
  "      campo('N° de certificado', '<input id=\"' + p + 'Cert\" value=\"' + esc(e ? e.certificado : '') + '\">') +",
  "      campo('Ubicación para el despacho', '<input id=\"' + p + 'Ubi\" list=\"almUbis\" value=\"' + esc(e ? e.ubicacion : '') + '\">') +",
  "      campo('Observaciones', '<textarea id=\"' + p + 'Obs\" placeholder=\"Embalaje, protección del equipo (nota 2), novedades...\"></textarea>', false, 'ancho') + '</div>';",
  "  }",
  "",
  "  // ---------- Movimientos ----------",
