  "@media (max-width:640px){.alm-hero{padding:20px}.alm-hero h2{font-size:24px}.alm-kpis{grid-template-columns:repeat(2,1fr)}.alm-form,.alm-form.d2,.alm-kv{grid-template-columns:1fr}",
